#!/bin/bash
# Checks every branch name and new commit before it reaches GitHub, where it would be public for good
# (see .github/scripts/privacy-check.sh).
set -euo pipefail
zero='0000000000000000000000000000000000000000'
failed=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  .github/scripts/privacy-check.sh ref "${remote_ref#refs/*/}" >/dev/null || {
    echo "✗ ${remote_ref#refs/*/}: name contains a private detail"
    failed=1
  }
  if [ "$remote_sha" = "$zero" ]; then
    range=("$local_sha" --not --remotes)
  else
    range=("$remote_sha..$local_sha")
  fi
  .github/scripts/privacy-check.sh commits "${range[@]}" || failed=1
done
exit "$failed"
