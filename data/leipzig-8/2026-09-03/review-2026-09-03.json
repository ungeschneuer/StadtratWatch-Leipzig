        {
          "seconds": 4352.6,
          "timecode": "1:12:32",
          "text": "Votum.",
          "highlight": false
        },
        {
          "seconds": 4371.24,
          "timecode": "1:12:51",
          "text": "Ich glaube, alle konnten abstimmen und das Ergebnis lautet 23, ja, 32, nein und",
          "highlight": false
        },
        {
          "seconds": 4376.3,
          "timecode": "1:12:56",
          "text": "fünf Enthaltungen. Herzlichen Dank dafür.",
          "highlight": true
        },
        {
          "seconds": 4379.24,
          "timecode": "1:12:59",
          "text": "Ich rufe jetzt die 11.4 auf, Vertreterinnen und Vertreter für den Aufsichtsrat.",
          "highlight": false
        },
        {
          "seconds": 4387.4,
          "timecode": "1:13:07",
          "text": "Wird das Wort gewünscht? Gibt es Gegenstimmen zur Besetzung, Enthaltungen,",
