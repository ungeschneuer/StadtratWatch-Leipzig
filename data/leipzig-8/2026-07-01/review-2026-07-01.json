      },
      "transcript": [
        {
          "seconds": 1028,
          "timecode": "0:17:08",
          "text": "Dann bitte ich Sie um Ihr Votum, zunächst zum Beschlusspunkt eins.",
          "highlight": false
        },
        {
          "seconds": 1036,
          "timecode": "0:17:16",
          "text": "Konnten alle abstimmen?",
          "highlight": false
        },
        {
          "seconds": 1058,
          "timecode": "0:17:38",
          "text": "Jetzt ja, 28 zu 23 zu 6, so beschlossen, und den Beschlusspunkt zwei und drei fasse",
          "highlight": true
        },
        {
          "seconds": 1074,
          "timecode": "0:17:54",
          "text": "ich zusammen.",
          "highlight": false
        },
        {
          "seconds": 1088,
          "timecode": "0:18:08",
          "text": "Und im Ergebnis heisst das 28 zu 23 zu 8, ebenfalls so beschlossen.",
          "highlight": true
        },
        {
          "seconds": 1102,
          "timecode": "0:18:22",
          "text": "Herzlichen Dank.",
          "highlight": false
        },
        {
          "seconds": 1106,
          "timecode": "0:18:26",
          "text": "Frau Doktor Heimann, zum Abstimmungsverhalten.",
          "highlight": false
        },
        {
          "seconds": 1109,
          "timecode": "0:18:29",
          "text": "Sehr geehrte Damen und Herren, insbesondere auch für unsere Gäste, wir haben",
          "highlight": false
        },
        {
          "seconds": 1115,
          "timecode": "0:18:35",
          "text": "uns deswegen gegen diese Vorlage ausgesprochen, weil wir auch schon alleine",
          "highlight": false
        },
        {
          "seconds": 1119,
          "timecode": "0:18:39",
          "text": "für die Gegengesellschaft gestimmt haben.",
          "highlight": false
        },
        {
          "seconds": 1121,
          "timecode": "0:18:41",
          "text": "Und die Gründe sind noch eklatanter eigentlich geworden, weil dieses Verfahren",
          "highlight": false
        },
        {
          "seconds": 1125,
          "timecode": "0:18:45",
          "text": "auch vom Bundesgesetz in diesem enormen Umfang auch nicht mehr gedeckt ist.",
          "highlight": false
        }
