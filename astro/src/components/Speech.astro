---
import { type SessionSpeech } from '@models/session-speech';
import { getFactionOfPerson, getPersonByName } from '@utils/session-utils';
import { type Registry, type RegistrySession } from '@models/registry';
import { sessionVideoLink } from '@models/session-video';
import ContactEmailLink from '@components/ContactEmailLink.astro';
import { SITE_NAME } from '@utils/site-config';

type Props = {
  parliamentPeriod: Registry;
  session: RegistrySession;
  speech: SessionSpeech;
  speechElementId: string;
  link: string;
};

const { parliamentPeriod, session, speech, speechElementId, link } =
  Astro.props as Props;

const person = getPersonByName(parliamentPeriod, session, speech.speaker);
const faction = person
  ? getFactionOfPerson(parliamentPeriod, session, person)
  : null;

const videoLink = sessionVideoLink(session, speech.start);
const linkTitle = getLinkTitle(speech.speaker, session.date);
const hintMail = getHintMail(speech, session.date);
const hintMailTitle = getHintMailTitle(speech);

function getLinkTitle(speaker: string, date: string): string {
  const formattedDate = new Date(date).toLocaleString('de-DE', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  });
  return `Redebeitrag von ${speaker} am ${formattedDate}`;
}

function getHintMail(
  speech: SessionSpeech,
  date: string,
): { subject: string; body: string } {
  const formattedDate = new Date(date).toLocaleString('de-DE', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  });
  const subject = `Hinweis zum Redebeitrag von ${speech.speaker} am ${formattedDate}`;
  const body = `Hallo ${SITE_NAME}-Team!

Ich habe einen Hinweis zum Redebeitrag von ${speech.speaker} aus der Sitzung vom ${formattedDate} (Zeitmarke: ${speech.start}):




Mit freundlichen Grüßen,

`;
  return { subject, body };
}

function getHintMailTitle(speech: SessionSpeech): string {
  return `Hinweis zum Redebeitrag von ${speech.speaker} geben`;
}
---

<article id={speechElementId} class="scroll-mt-20">
  <header class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm">
    <span class="font-semibold">{speech.speaker}</span>
    {faction && <span class="text-base-content/70">{faction.name}</span>}
    {speech.onBehalfOf && (
      <span class="text-base-content/70">{speech.onBehalfOf}</span>
    )}
    <div class="dropdown dropdown-end ml-auto self-center">
      <button
        aria-label="Weitere Aktionen zum Redebeitrag"
        tabindex="0"
        class="btn btn-sm btn-ghost btn-square"
      >
        <span class="iconify lucide--more-horizontal" aria-hidden="true"></span>
      </button>
      <ul
        tabindex="0"
        class="dropdown-content menu bg-base-100 rounded-box border-base-300 z-10 w-60 border p-2 shadow-sm"
      >
        <li>
          <a
            class="copy-speech-link-btn"
            href={`${link}#${speechElementId}`}
            title={linkTitle}
            aria-label={linkTitle}
          >
            Link zum Beitrag kopieren
          </a>
        </li>
        <li>
          <ContactEmailLink
            title={hintMailTitle}
            subject={hintMail.subject}
            body={hintMail.body}
          >
            Beitrag melden
          </ContactEmailLink>
        </li>
      </ul>
    </div>
  </header>
  <div
    class="mt-2 max-w-prose space-y-3 leading-relaxed hyphens-auto"
    lang="de"
  >
    {(speech.transcription || '').split('\n\n').map((line) => (
      <p>{line}</p>
    ))}
  </div>
  {videoLink && (
    <p class="mt-3 text-sm">
      <a href={videoLink.url} target="_blank" class="link link-primary">
        {videoLink.text}
      </a>
    </p>
  )}
</article>
