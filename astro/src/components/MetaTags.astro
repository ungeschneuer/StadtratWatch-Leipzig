---
import { Seo } from 'astro-seo-meta';
import { formatDate } from '@utils/format-date';
import { type SessionScanItem } from '@models/session-scan';
import { SITE_NAME } from '@utils/site-config';
import { sitePath } from '@utils/site-path';
import { ogImagePathOf } from '@utils/og-image-path';

interface MetaTagsProps {
  pageTitle?: string;
  factionName?: string;
  partyName?: string;
  personName?: string;
  sessionDate?: string;
  voting?: SessionScanItem;
}

const { pageTitle, factionName, partyName, personName, sessionDate, voting } =
  Astro.props as MetaTagsProps;

let title = pageTitle ? `${SITE_NAME}: ${pageTitle}` : SITE_NAME;
let description =
  'Wie jedes Mitglied des Leipziger Stadtrats abstimmt: Abstimmungen, Anträge und Redebeiträge der Ratsversammlung.';

if (factionName) {
  title = `${SITE_NAME}: ${factionName}`;
  description = `${factionName}: Abstimmungen, Anwesenheiten und andere Daten und Analysen der Fraktion im Leipziger Stadtrat`;
}

if (partyName) {
  title = `${SITE_NAME}: ${partyName}`;
  description = `${partyName}: Abstimmungen, Anwesenheiten und andere Daten und Analysen der Partei im Leipziger Stadtrat`;
}

if (personName) {
  title = `${SITE_NAME}: ${personName}`;
  description = `${personName}: Abstimmungen, Anwesenheiten, Redebeiträge und andere Analysen im Leipziger Stadtrat`;
}

if (sessionDate) {
  const sessionDateDisplay = formatDate(sessionDate);
  title = `${SITE_NAME}: Sitzung vom ${sessionDateDisplay}`;
  description = `${sessionDateDisplay}: Abstimmungen, Redebeiträge und andere Daten und Analysen der Sitzung des Leipziger Stadtrats`;
}

if (voting) {
  title = getTitleForVoting(voting, sessionDate!);
  description = voting.votingSubject.title;
}

function getTitleForVoting(
  voting: SessionScanItem,
  sessionDate: string,
): string {
  switch (voting.votingSubject.type) {
    case 'Änderungsantrag':
      return voting.votingSubject.motionId
        ? `${SITE_NAME}: Änderungsantrag ${voting.votingSubject.motionId}`
        : `${SITE_NAME}: Änderungsantrag am ${formatDate(sessionDate)}`;

    case 'Antrag':
      return voting.votingSubject.motionId
        ? `${SITE_NAME}: Antrag ${voting.votingSubject.motionId}`
        : `${SITE_NAME}: Antrag am ${formatDate(sessionDate)}`;

    case 'Beschlussvorlage':
      return voting.votingSubject.motionId
        ? `${SITE_NAME}: Beschlussvorlage ${voting.votingSubject.motionId}`
        : `${SITE_NAME}: Beschlussvorlage am ${formatDate(sessionDate)}`;

    case 'Delegation':
      return `${SITE_NAME}: Abstimmung zur Delegation am ${formatDate(sessionDate)}`;

    case 'Geschäftsordnung':
      return voting.votingSubject.motionId
        ? `${SITE_NAME}: Geschäftsordnungsantrag zu ${voting.votingSubject.motionId}`
        : `${SITE_NAME}: Geschäftsordnungsantrag am ${formatDate(sessionDate)}`;

    case 'Niederschrift':
      return `${SITE_NAME}: Abstimmung zur Niederschrift am ${formatDate(sessionDate)}`;

    case 'Redaktionelle Änderung':
      return voting.votingSubject.motionId
        ? `${SITE_NAME}: Redaktionelle Änderung zu ${voting.votingSubject.motionId}`
        : `${SITE_NAME}: Redaktionelle Änderung am ${formatDate(sessionDate)}`;

    case 'Tagesordnung':
      return `${SITE_NAME}: Abstimmung zur Tagesordnung am ${formatDate(sessionDate)}`;
  }

  return `${SITE_NAME}: Abstimmung am ${formatDate(sessionDate)}`;
}
// Pages that name one thing have a preview image of their own (pages/og/); all others share the start page's.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const pagePath = Astro.url.pathname.slice(
  import.meta.env.BASE_URL.replace(/\/$/, '').length,
);
const hasOwnImage = Boolean(
  factionName || partyName || personName || sessionDate || voting,
);
const imageUrl = new URL(
  sitePath(ogImagePathOf(hasOwnImage ? pagePath : '')),
  Astro.site,
).href;
---

<Seo
  title={title}
  description={description}
  facebook={{
    type: 'website',
    image: imageUrl,
    url: pageUrl,
  }}
  twitter={{
    card: 'summary_large_image',
    image: imageUrl,
  }}
/>
