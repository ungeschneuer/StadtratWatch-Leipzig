---
import { siteRoutes } from '@utils/routes';
import { sitePath } from '@utils/site-path';
import { getCollection } from 'astro:content';
import { type Registry } from '@models/registry';
import { formatDate } from '@utils/format-date';
import {
  CONTACT_EMAIL,
  OPERATOR_NAME,
  SITE_NAME,
  SOURCE_REPOSITORY_URL,
  UPSTREAM_PROJECT,
} from '@utils/site-config';

const parliamentPeriodsCollection = await getCollection('parliamentPeriods');
const parliamentPeriods = parliamentPeriodsCollection
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .map((parliamentPeriodEntry) => parliamentPeriodEntry.data);

type Props = {
  parliamentPeriod: Registry;
};

const { parliamentPeriod } = Astro.props as Props;

const routes = siteRoutes(parliamentPeriod.id);
const pathname = Astro.url.pathname.replace(/\/$/, '');
const isSectionOf = (listPath: string, itemPathPrefix: string) =>
  pathname === listPath || pathname.startsWith(itemPathPrefix);
let activePage = '';
switch (true) {
  case pathname === sitePath('/suche'):
    activePage = 'search';
    break;
  case isSectionOf(routes.sessions(), routes.session('')):
    activePage = 'sessions';
    break;
  case isSectionOf(routes.factions(), routes.faction('')):
    activePage = 'factions';
    break;
  case isSectionOf(routes.parties(), routes.party('')):
    activePage = 'parties';
    break;
  case isSectionOf(routes.persons(), routes.person('')):
    activePage = 'persons';
    break;
}
---

<input
  type="checkbox"
  id="layout-sidebar-toggle-trigger"
  class="hidden"
  aria-label="Toggle layout sidebar"
/>

<div id="layout-sidebar">
  <a
    class="flex min-h-16 items-center px-5 text-xl md:text-2xl font-bold text-primary"
    href={sitePath('/')}
  >
    {SITE_NAME}
  </a>
  <div class="relative min-h-0 grow">
    <div class="size-full">
      <div class="dropdown w-full">
        <div
          tabindex="0"
          role="button"
          class="bg-base-200 hover:bg-base-300 rounded-box mx-2 mt-0 flex cursor-pointer items-center gap-2.5 px-3 py-2 transition-all"
        >
          <div class="grow">
            <p class="text-sm font-medium">{parliamentPeriod.name}</p>
            <p class="text-base-content/60 text-xs">
              Stand: {formatDate(parliamentPeriod.lastUpdate)}
            </p>
          </div>
          <span class="iconify lucide--chevrons-up-down text-base-content/60 size-4"></span>
        </div>
        <ul
          role="menu"
          class="dropdown-content menu bg-base-100 rounded-box shadow-base-content/4 mb-1 w-48 p-1 shadow-[0px_-10px_40px_0px]"
          tabindex="0"
        >
          {parliamentPeriods.map((parliamentPeriod) => (
            <li>
              <a href={siteRoutes(parliamentPeriod.id).parliamentPeriod()}>
                <span>{parliamentPeriod.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div id="sidebar-menu" class="mt-3">
        <a
          class="sidebar-menu-item"
          class:list={[{ active: activePage === 'search' }]}
          href={sitePath('/suche')}
        >
          Suche
        </a>
        <a
          class="sidebar-menu-item"
          class:list={[{ active: activePage === 'sessions' }]}
          href={siteRoutes(parliamentPeriod.id).sessions()}
        >
          Sitzungen
        </a>
        <a
          class="sidebar-menu-item"
          class:list={[{ active: activePage === 'factions' }]}
          href={siteRoutes(parliamentPeriod.id).factions()}
        >
          Fraktionen
        </a>
        <a
          class="sidebar-menu-item"
          class:list={[{ active: activePage === 'parties' }]}
          href={siteRoutes(parliamentPeriod.id).parties()}
        >
          Parteien
        </a>
        <a
          class="sidebar-menu-item"
          class:list={[{ active: activePage === 'persons' }]}
          href={siteRoutes(parliamentPeriod.id).persons()}
        >
          Personen
        </a>
      </div>
    </div>
  </div>

  <div class="alert alert-soft alert-info m-3 dark:opacity-60" role="alert">
    <span class="space-y-1">
      <span class="block">
        Ein ehrenamtliches Projekt von {OPERATOR_NAME},{' '}
        <a class="link" href={`mailto:${CONTACT_EMAIL}`}>
          {CONTACT_EMAIL}
        </a>
        . <em>Keine</em> offizielle Seite der Stadt Leipzig.
      </span>
      <span class="block text-xs">
        Grundlage:{' '}
        <a class="link" href={UPSTREAM_PROJECT.siteUrl} target="_blank">
          {UPSTREAM_PROJECT.name}
        </a>{' '}
        von{' '}
        <a class="link" href={UPSTREAM_PROJECT.maintainersUrl} target="_blank">
          {UPSTREAM_PROJECT.maintainers}
        </a>
        .
      </span>
    </span>
  </div>

  <div class="mb-2">
    <hr class="border-base-300" />
    <ul class="menu w-full">
      <li>
        <a href={SOURCE_REPOSITORY_URL} class="flex items-center gap-2">
          <span class="iconify lucide--github size-4"></span>
          Quellcode
        </a>
      </li>
      <li>
        <a href={sitePath('/api')} class="flex items-center gap-2">
          <span class="iconify lucide--code-2 size-4"></span>
          API
        </a>
      </li>
      <li>
        <a href={sitePath('/datenschutz')} class="flex items-center gap-2">
          <span class="iconify lucide--cookie size-4"></span>
          Datenschutz
        </a>
      </li>
      <li>
        <a href={sitePath('/impressum')} class="flex items-center gap-2">
          <span class="iconify lucide--section size-4"></span>
          Impressum
        </a>
      </li>
      <li>
        <a href={sitePath('/kontakt')} class="flex items-center gap-2">
          <span class="iconify lucide--mail size-4"></span>
          Kontakt
        </a>
      </li>
    </ul>
  </div>
</div>

<label for="layout-sidebar-toggle-trigger" id="layout-sidebar-backdrop"></label>
