---
import { siteRoutes } from '@utils/routes';
import { sitePath } from '@utils/site-path';
import { getCollection } from 'astro:content';
import { type Registry } from '@models/registry';
import { formatDate } from '@utils/format-date';
import {
  CONTACT_EMAIL,
  OPERATOR_NAME,
  SITE_NAME,
  SOURCE_REPOSITORY_URL,
  UPSTREAM_PROJECT,
} from '@utils/site-config';

const parliamentPeriodsCollection = await getCollection('parliamentPeriods');
const parliamentPeriods = parliamentPeriodsCollection
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .map((parliamentPeriodEntry) => parliamentPeriodEntry.data);

type Props = {
  parliamentPeriod: Registry;
};

const { parliamentPeriod } = Astro.props as Props;

const routes = siteRoutes(parliamentPeriod.id);
const pathname = Astro.url.pathname.replace(/\/$/, '');
const isSectionOf = (listPath: string, itemPathPrefix: string) =>
  pathname === listPath || pathname.startsWith(itemPathPrefix);
let activePage = '';
switch (true) {
  case pathname === sitePath('/suche'):
    activePage = 'search';
    break;
  case isSectionOf(routes.sessions(), routes.session('')):
    activePage = 'sessions';
    break;
  case isSectionOf(routes.factions(), routes.faction('')):
    activePage = 'factions';
    break;
  case isSectionOf(routes.parties(), routes.party('')):
    activePage = 'parties';
    break;
  case isSectionOf(routes.persons(), routes.person('')):
    activePage = 'persons';
    break;
}

const sections = [
  {
    page: 'search',
    label: 'Suche',
    href: sitePath('/suche'),
    icon: 'lucide--search',
  },
  {
    page: 'sessions',
    label: 'Sitzungen',
    href: routes.sessions(),
    icon: 'lucide--calendar-days',
  },
  {
    page: 'factions',
    label: 'Fraktionen',
    href: routes.factions(),
    icon: 'lucide--users',
  },
  {
    page: 'parties',
    label: 'Parteien',
    href: routes.parties(),
    icon: 'lucide--flag',
  },
  {
    page: 'persons',
    label: 'Personen',
    href: routes.persons(),
    icon: 'lucide--user',
  },
];
const aboutLinks = [
  { label: 'Quellcode', href: SOURCE_REPOSITORY_URL, icon: 'lucide--github' },
  { label: 'API und Daten', href: sitePath('/api'), icon: 'lucide--code-2' },
  {
    label: 'Datenschutz',
    href: sitePath('/datenschutz'),
    icon: 'lucide--shield',
  },
  { label: 'Impressum', href: sitePath('/impressum'), icon: 'lucide--scale' },
  { label: 'Kontakt', href: sitePath('/kontakt'), icon: 'lucide--mail' },
];
---

<aside
  class="bg-base-100 border-base-300 flex min-h-full w-72 flex-col border-r"
  aria-label="Navigation"
>
  <a
    href={sitePath('/')}
    class="text-primary flex min-h-16 items-center px-5 text-xl font-bold"
  >
    {SITE_NAME}
  </a>

  <div class="dropdown mx-3 mb-2">
    <div
      tabindex="0"
      role="button"
      class="bg-base-200 hover:bg-base-300 rounded-field flex cursor-pointer items-center gap-2 px-3 py-2"
    >
      <div class="grow">
        <p class="text-sm font-semibold">{parliamentPeriod.name}</p>
        <p class="text-base-content/70 text-xs">
          Stand: {formatDate(parliamentPeriod.lastUpdate)}
        </p>
      </div>
      <span class="iconify lucide--chevrons-up-down text-base-content/70 size-4"></span>
    </div>
    <ul
      tabindex="0"
      class="dropdown-content menu bg-base-100 rounded-box border-base-300 z-10 mt-1 w-full border p-1 shadow-sm"
    >
      {parliamentPeriods.map((period) => (
        <li>
          <a href={siteRoutes(period.id).parliamentPeriod()}>{period.name}</a>
        </li>
      ))}
    </ul>
  </div>

  <nav aria-label="Bereiche">
    <ul class="menu w-full gap-0.5 px-3">
      {sections.map((section) => (
        <li>
          <a
            href={section.href}
            class:list={[{ 'menu-active': activePage === section.page }]}
            aria-current={activePage === section.page ? 'page' : undefined}
          >
            <span class:list={['iconify size-4', section.icon]} />
            {section.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="grow"></div>

  <div class="alert alert-soft alert-info mx-3 my-3 text-sm" role="note">
    <div class="space-y-1">
      <p>
        Ein ehrenamtliches Projekt von {OPERATOR_NAME},{' '}
        <a class="link" href={`mailto:${CONTACT_EMAIL}`}>
          {CONTACT_EMAIL}
        </a>
        . <em>Keine</em> offizielle Seite der Stadt Leipzig.
      </p>
      <p class="text-xs">
        Grundlage:{' '}
        <a class="link" href={UPSTREAM_PROJECT.siteUrl} target="_blank">
          {UPSTREAM_PROJECT.name}
        </a>{' '}
        von{' '}
        <a class="link" href={UPSTREAM_PROJECT.maintainersUrl} target="_blank">
          {UPSTREAM_PROJECT.maintainers}
        </a>
        .
      </p>
    </div>
  </div>

  <nav aria-label="Über die Seite" class="border-base-300 border-t pb-2">
    <ul class="menu menu-sm w-full px-3">
      {aboutLinks.map((link) => (
        <li>
          <a href={link.href}>
            <span class:list={['iconify size-4', link.icon]} />
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>
