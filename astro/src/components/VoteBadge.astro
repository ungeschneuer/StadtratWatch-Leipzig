---
import type { VoteCode } from '@models/Session';

// A vote is never shown by colour alone: the badge names it, and screen readers hear the full word. „Unklar“ marks a
// member without a vote on the board who may have cast one of the votes counted by hand without a name.
type Props = { vote: VoteCode; uncertain?: boolean };

const VOTES: Record<
  VoteCode,
  { short: string; label: string; className: string }
> = {
  J: { short: 'Ja', label: 'Ja', className: 'badge-success' },
  N: { short: 'Nein', label: 'Nein', className: 'badge-error' },
  E: { short: 'Enth.', label: 'Enthaltung', className: 'badge-warning' },
  O: {
    short: '–',
    label: 'keine Stimme',
    className: 'badge-ghost text-base-content/70',
  },
};

const UNCERTAIN = {
  short: 'unklar',
  label: 'unklar, möglicherweise von Hand nachgezählt',
  className: 'badge-info',
};

const { vote, uncertain = false } = Astro.props;
const { short, label, className } = uncertain ? UNCERTAIN : VOTES[vote];
---

<span class:list={['badge badge-soft badge-sm min-w-12 shrink-0', className]}>
  <span aria-hidden="true">{short}</span>
  <span class="sr-only">{label}</span>
</span>
