---
import { type BreadcrumbItem } from '@components/BreadcrumbMenu.astro';
import BreadcrumbMenu from './BreadcrumbMenu.astro';

type Props = {
  pageTitle: string;
  searchTitle?: string;
  breadcrumbItems?: BreadcrumbItem[];
};

const { pageTitle, searchTitle, breadcrumbItems } = Astro.props as Props;
---

<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
  <h1
    class="text-xl font-semibold sm:text-2xl"
    data-pagefind-meta={searchTitle ? `title:${searchTitle}` : 'title'}
  >
    {pageTitle}
  </h1>
  <div data-pagefind-ignore>
    <BreadcrumbMenu breadcrumbItems={breadcrumbItems} />
  </div>
</div>
