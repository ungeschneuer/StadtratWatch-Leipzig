---
import { sitePath } from '@utils/site-path';
import { SITE_NAME } from '@utils/site-config';
---

<header class="navbar bg-base-100 border-base-300 sticky top-0 z-30 border-b px-2 lg:hidden">
  <label for="site-navigation" class="btn btn-square btn-ghost">
    <span class="iconify lucide--menu size-5" aria-hidden="true"></span>
    <span class="sr-only">Navigation öffnen</span>
  </label>
  <a href={sitePath('/')} class="text-primary ml-1 text-lg font-bold">
    {SITE_NAME}
  </a>
</header>
