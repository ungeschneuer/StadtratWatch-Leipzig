---
import StatisticsTable, {
  type StatisticsMeasure,
} from '@components/StatisticsTable.astro';
import { formatPercentage } from '@utils/format-number';
import { type Registry, type RegistryPerson } from '@models/registry';
import { type SessionInput } from '@models/SessionInput';
import { calcVotingSuccessRateOfPerson } from '@data-analysis/VotingSuccess';
import { calcVotingSuccessRateHistoryOfPerson } from '@data-analysis/VotingSuccess';
import {
  calcParticipationRateHistoryOfPerson,
  calcParticipationRateOfPerson,
} from '@data-analysis/ParticipationRate';
import {
  calcAbstentionRateHistoryOfPerson,
  calcAbstentionRateOfPerson,
} from '@data-analysis/AbstentionRate';
import { calcFactionDeviationOfPerson } from '@data-analysis/FactionDeviation';

type Props = {
  parliamentPeriod: Registry;
  person: RegistryPerson;
  sessionInputs: SessionInput[];
};

const { parliamentPeriod, person, sessionInputs } = Astro.props as Props;

const votingsSuccessRate = calcVotingSuccessRateOfPerson(
  parliamentPeriod,
  person,
  sessionInputs,
);
const votingsSuccessRateHistory = calcVotingSuccessRateHistoryOfPerson(
  parliamentPeriod,
  person,
  sessionInputs,
);
const participationRate = calcParticipationRateOfPerson(person, sessionInputs);
const participationRateHistory = calcParticipationRateHistoryOfPerson(
  person,
  sessionInputs,
);
const abstentionRate = calcAbstentionRateOfPerson(person, sessionInputs);
const factionDeviation = calcFactionDeviationOfPerson(
  parliamentPeriod,
  person,
  sessionInputs,
);
const factionDeviationRate =
  factionDeviation && factionDeviation.counted > 0
    ? factionDeviation.deviating / factionDeviation.counted
    : null;
const abstentionRateHistory = calcAbstentionRateHistoryOfPerson(
  person,
  sessionInputs,
);

const measures: StatisticsMeasure[] = [
  {
    id: 'participation-rate',
    label: 'Abstimmungsteilnahme',
    value: formatPercentage(participationRate),
    explanation:
      'Wie häufig das Ratsmitglied an Abstimmungen teilgenommen hat.',
    history: participationRateHistory,
  },
  {
    id: 'voting-success-rate',
    label: 'Abstimmungserfolg',
    value: formatPercentage(votingsSuccessRate),
    explanation:
      'Wie häufig das Abstimmungsergebnis mit dem Votum des Ratsmitglieds übereinstimmte.',
    history: votingsSuccessRateHistory,
  },
  {
    id: 'abstention-rate',
    label: 'Stimmenthaltungen',
    value: formatPercentage(abstentionRate),
    explanation:
      'Anteil der abgegebenen Stimmen, die weder dafür noch dagegen waren.',
    history: abstentionRateHistory,
  },
  ...(factionDeviation
    ? [
        {
          id: 'faction-deviation',
          label: 'Abweichung von der Fraktion',
          value: formatPercentage(factionDeviationRate),
          explanation: `Anteil der abgegebenen Stimmen, die nicht der Mehrheit der eigenen Fraktion entsprachen (${factionDeviation.deviating} von ${factionDeviation.counted}). Auch eine Enthaltung zählt, wenn die Fraktion mehrheitlich mit Ja oder Nein stimmte; ist die Fraktion gespalten, zählt die Abstimmung nicht.`,
        },
      ]
    : []),
];
---

<StatisticsTable measures={measures} />
