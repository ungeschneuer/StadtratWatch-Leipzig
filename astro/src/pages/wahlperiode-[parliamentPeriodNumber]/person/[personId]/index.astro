---
import { siteRoutes } from '@utils/routes';
import {
  type ParliamentPeriodWithPersonProps,
  getParliamentPeriodWithPersonPaths,
} from '../../_helpers';
import PageLayout from '@layouts/PageLayout.astro';
import Statistics from './_statistics.astro';
import VotingMatrix from './_voting-matrix.astro';
import Speeches from './_speeches.astro';
import MetaTags from '@components/MetaTags.astro';
import ExtremistClassificationAlert from '@components/ExtremistClassificationAlert.astro';
import { extractExtremistClassificationInformation } from '@utils/party-utils';
import {
  type AffiliationPeriod,
  factionHistory,
  partyHistory,
} from '@models/person-affiliation';
import { formatPeriod } from '@utils/format-period';
import { formatDate } from '@utils/format-date';
import { missingActivityOf } from '@data-analysis/MissingActivity';

export const getStaticPaths = getParliamentPeriodWithPersonPaths;

const { personId } = Astro.params;
const { parliamentPeriod, sessionInputs, person } =
  Astro.props as ParliamentPeriodWithPersonProps;
const missingActivity = missingActivityOf(person, sessionInputs);

function noVoteText(name: string, recordedSessions: number): string {
  if (recordedSessions === 0) {
    return `Seit ${name} der Ratsversammlung angehört, gab es noch keine aufgezeichnete Sitzung.`;
  }
  const sessions =
    recordedSessions === 1
      ? 'der einen aufgezeichneten Sitzung'
      : `den ${recordedSessions} aufgezeichneten Sitzungen`;
  return `In ${sessions} während der Mitgliedschaft hat ${name} an keiner Abstimmung teilgenommen.`;
}
const parliamentPeriodId = parliamentPeriod.id;

const faction = parliamentPeriod.factions.find(
  (faction) => faction.id === person.factionId,
);
if (!faction) {
  throw new Error(
    `Faction with ID ${person.factionId} not found in parliament period ${parliamentPeriodId}`,
  );
}
const party = parliamentPeriod.parties.find(
  (party) => party.id === person.partyId,
);
if (!party) {
  throw new Error(
    `Party with ID ${person.partyId} not found in parliament period ${parliamentPeriodId}`,
  );
}

// Shown only for members who changed faction or party during the period.
function describeHistory(
  periods: AffiliationPeriod[],
  nameOf: (id: string) => string | undefined,
): string | null {
  if (new Set(periods.map((period) => period.id)).size < 2) return null;
  return periods
    .map(
      (period) =>
        `${nameOf(period.id) ?? period.id} ${formatPeriod(period.start, period.end)}`,
    )
    .join(', ');
}
const factionChanges = describeHistory(
  factionHistory(person),
  (id) => parliamentPeriod.factions.find((faction) => faction.id === id)?.name,
);
const partyChanges = describeHistory(
  partyHistory(person),
  (id) => parliamentPeriod.parties.find((party) => party.id === id)?.name,
);

const {
  extremistClassification,
  extremistClassificationReason,
  extremistClassificationSource,
  extremistClassificationSourceUrl,
} = extractExtremistClassificationInformation(party);
---

<PageLayout
  parliamentPeriod={parliamentPeriod}
  pageTitle={person.name}
  breadcrumbItems={[
    {
      name: parliamentPeriod.name,
      href: siteRoutes(parliamentPeriodId).parliamentPeriod(),
    },
    {
      name: 'Personen',
      href: siteRoutes(parliamentPeriodId).persons(),
    },
    {
      name: person.name,
      href: null,
    },
  ]}
>
  <MetaTags slot="srw-meta-tags" personName={person.name} />

  {extremistClassification && (
    <div class="mb-4">
      <ExtremistClassificationAlert
        extremistClassificationReason={extremistClassificationReason}
        extremistClassificationSource={extremistClassificationSource}
        extremistClassificationSourceUrl={extremistClassificationSourceUrl}
      />
    </div>
  )}

  <div slot="sub-page-header">
    <div class="flex flex-row flex-wrap text-base-content/60 text-sm gap-x-4">
      <div>
        Fraktion:{' '}
        <a
          href={siteRoutes(parliamentPeriodId).faction(person.factionId)}
          class="link link-hover link-primary"
        >
          {faction.name}
        </a>
      </div>
      <div>
        Partei (Wahlliste 2024):{' '}
        <a
          href={siteRoutes(parliamentPeriodId).party(person.partyId)}
          class="link link-hover link-primary"
        >
          {party.name}
        </a>
      </div>
    </div>
    {factionChanges && (
      <div class="text-base-content/60 text-xs mt-1">
        Fraktionen in der Wahlperiode: {factionChanges}
      </div>
    )}
    {partyChanges && (
      <div class="text-base-content/60 text-xs mt-1">
        Parteien in der Wahlperiode: {partyChanges}
      </div>
    )}
  </div>

  {missingActivity?.reason === 'left-before-recordings' && (
    <div role="note" class="alert alert-soft mb-4 text-sm">
      {person.name} gehörte der Ratsversammlung bis zum{' '}
      {formatDate(missingActivity.end)} an. Die Stadt zeichnet die Sitzungen
      erst seit dem {formatDate(missingActivity.firstRecordedSession)} auf;
      Abstimmungen, Reden und Statistiken gibt es deshalb erst ab diesem Tag.
    </div>
  )}
  {missingActivity?.reason === 'no-vote-while-member' && (
    <div role="note" class="alert alert-soft mb-4 text-sm">
      {noVoteText(person.name, missingActivity.recordedSessions)}
    </div>
  )}

  <div
    id="tabs"
    role="tablist"
    class="tabs tabs-lift"
    x-data="person"
    data-parliament-period-id={parliamentPeriodId}
    data-person-id={personId}
  >
    <input
      role="tab"
      class="tab"
      aria-label="Statistiken"
      type="radio"
      name="demo-tabs-radio"
      :checked="currentTab === 'statistics'"
      @change="history.pushState(null, '', '?tab=statistics'); currentTab = 'statistics'"
    />
    <div class="tab-content border-base-200 bg-base-100 p-3 sm:p-6">
      <Statistics
        parliamentPeriod={parliamentPeriod}
        person={person}
        sessionInputs={sessionInputs}
      />
    </div>

    <input
      role="tab"
      class="tab"
      aria-label="Redebeiträge"
      type="radio"
      name="demo-tabs-radio"
      :checked="currentTab === 'speeches'"
      @change="history.pushState(null, '', '?tab=speeches'); currentTab = 'speeches'"
    />
    <div class="tab-content border-base-200 bg-base-100 p-3 sm:p-6">
      <Speeches
        parliamentPeriod={parliamentPeriod}
        person={person}
        sessions={sessionInputs}
      />
    </div>

    <input
      role="tab"
      class="tab"
      aria-label="Vergleiche"
      type="radio"
      name="demo-tabs-radio"
      :checked="currentTab === 'voting-matrix'"
      @change="history.pushState(null, '', '?tab=voting-matrix'); currentTab = 'voting-matrix'"
    />
    <div class="tab-content border-base-200 bg-base-100 p-3 sm:p-6">
      <VotingMatrix
        parliamentPeriod={parliamentPeriod}
        person={person}
        sessions={sessionInputs}
      />
    </div>
  </div>
</PageLayout>

<script>
  import Alpine from 'alpinejs';

  document.addEventListener('alpine:init', () => {
    const currentUrl = new URL(window.location.href);
    const currentTab = currentUrl.searchParams.get('tab') || 'statistics';

    const sessionsDivElement = document.getElementById(
      'tabs',
    ) as HTMLDivElement;
    const parliamentPeriodId = sessionsDivElement.dataset.parliamentPeriodId;
    const personId = sessionsDivElement.dataset.personId;
    Alpine.data('person', () => ({
      parliamentPeriodId,
      personId,
      currentTab,
    }));
  });

  window.addEventListener('popstate', () => {
    // TODO: Manage back/forward navigation
  });
</script>
