---
import { siteRoutes } from '@utils/routes';
import { type Registry } from '@models/registry';
import { type SessionInput } from '@models/SessionInput';
import { type RegistryPerson } from '@models/registry';
import Speech from '@components/Speech.astro';
import { formatDate } from '@utils/format-date';
import { formatSpeakingTime } from '@utils/format-time';

type Props = {
  parliamentPeriod: Registry;
  person: RegistryPerson;
  sessions: SessionInput[];
};

const { parliamentPeriod, person, sessions } = Astro.props as Props;

const speechesBySessionDate = sessions
  .flatMap((session) => ({
    session: session.session,
    speeches: session.speeches
      .filter((speech) => speech.speaker === person.name)
      .filter((speech) => !speech.isChairPerson)
      .filter((speech) => !!speech.transcription)
      .toSorted((a, b) => a.start - b.start),
  }))
  .filter((session) => session.speeches.length > 0)
  .toSorted((a, b) => b.session.id.localeCompare(a.session.id));

// Texts from an official record are shown per session only: a collection of one person's speeches is not covered by
// § 48 UrhG. The person page lists them with a link to the session.
const hasRecordedSpeeches = speechesBySessionDate.some(
  ({ session }) => session.speechesSource,
);
---

<div class="text-base-content/70 max-w-prose space-y-2 text-sm">
  {hasRecordedSpeeches ? (
    <p>
      Die Texte der Redebeiträge stammen aus dem Protokoll der jeweiligen
      Sitzung und stehen dort zusammen mit allen anderen Beiträgen. Hier sind
      Datum und Dauer der Beiträge aufgeführt, mit einem Link zum Beitrag in der
      Sitzung.
    </p>
  ) : (
    <p>
      Die folgenden Redebeiträge wurden automatisiert erstellt und können Fehler
      enthalten. Die Texte dienen nur zur Orientierung und sind nicht als
      offizielle Protokolle zu verstehen. Um Aufzeichnungen der Redebeiträge
      anzuhören, nutzen Sie bitte die Links zur jeweiligen Aufzeichnung.
    </p>
  )}
  <p>
    Sollten Sie einen Fehler entdecken, können Sie uns diesen gern melden.
    Öffnen Sie dazu den Beitrag in der Sitzung und wählen Sie im Menü „…“ neben
    dem Redebeitrag „Beitrag melden“. Wir werden den Fehler umgehend prüfen und
    korrigieren.
  </p>
</div>

{speechesBySessionDate.length === 0 && (
  <p class="text-base-content/70 mt-6">
    Von {person.name} liegen noch keine Redebeiträge vor.
  </p>
)}

<div class="mt-8 max-w-4xl space-y-8">
  {speechesBySessionDate.map((speechesBySessionDate) => {
    const sessionUrl = siteRoutes(parliamentPeriod.id).session(
      speechesBySessionDate.session.id,
    );
    return (
      <section>
        <h3 class="font-semibold">
          <a href={sessionUrl} class="link-quiet">
            {formatDate(speechesBySessionDate.session.date)}
          </a>
          {speechesBySessionDate.session.title && (
            <span class="text-base-content/70 font-normal">
              , {speechesBySessionDate.session.title}
            </span>
          )}
        </h3>
        {speechesBySessionDate.session.speechesSource ? (
          <ul class="divide-base-300 border-base-300 mt-2 divide-y border-y text-sm">
            {speechesBySessionDate.speeches.map((speech) => (
              <li class="flex flex-wrap justify-between gap-x-4 py-2">
                <span>
                  Redebeitrag, {formatSpeakingTime(speech.duration, false)}
                </span>
                <a
                  class="link link-primary"
                  href={`${sessionUrl}?tab=speeches#speech-${speech.start}`}
                >
                  In der Sitzung lesen
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <ol class="divide-base-300 border-base-300 mt-2 divide-y border-y">
            {speechesBySessionDate.speeches.map((speech) => (
              <li class="py-5">
                <Speech
                  parliamentPeriod={parliamentPeriod}
                  session={speechesBySessionDate.session}
                  speech={speech}
                  speechElementId={`speech-${speechesBySessionDate.session.id}-${speech.start}`}
                  link={`${siteRoutes(parliamentPeriod.id).person(person.id)}?tab=speeches`}
                />
              </li>
            ))}
          </ol>
        )}
      </section>
    );
  })}
</div>

<p
  id="speech-link-copied"
  role="status"
  class="alert alert-success fixed right-5 bottom-5 hidden"
>
  Link zum Redebeitrag kopiert
</p>

<script>
  document.querySelectorAll('.copy-speech-link-btn').forEach((button) => {
    button.addEventListener('click', async (event) => {
      event.preventDefault();
      if (document.activeElement) {
        (document.activeElement as HTMLElement).blur();
      }
      const href = button.getAttribute('href');
      if (!href) {
        return;
      }
      await navigator.clipboard.writeText(
        new URL(href, window.location.origin).toString(),
      );

      const alert = document.getElementById('speech-link-copied');
      if (alert) {
        alert.classList.remove('hidden');
        setTimeout(() => alert.classList.add('hidden'), 3000);
      }
    });
  });
</script>
