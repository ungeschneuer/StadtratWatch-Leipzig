---
import { siteRoutes } from '@utils/routes';
import { sortValue } from '@utils/sortable-table';
import { nameForSorting } from '@models/person-name';
import { type Registry, type RegistryPerson } from '@models/registry';
import { type SessionInput } from '@models/SessionInput';
import { calcVotingMatrix } from '@data-analysis/VotingMatrix';
import { formatPercentage } from '@utils/format-number';

type Props = {
  parliamentPeriod: Registry;
  person: RegistryPerson;
  sessions: SessionInput[];
};

const { parliamentPeriod, person, sessions } = Astro.props as Props;

const votingMatrix = calcVotingMatrix(parliamentPeriod, person, sessions)
  .map((row) => ({
    ...row,
    comparisonScoreDisplay: formatPercentage(row.comparisonScore),
  }))
  .toSorted((a, b) => b.comparisonScore - a.comparisonScore);
const parliamentPeriodId = parliamentPeriod.id;
---

<div class="@container overflow-x-auto">
  <table data-sortable class="table table-sm md:table-md table-pin-cols">
    <thead>
      <tr>
        <th scope="col">
          <button
            class="hover:text-primary flex w-full cursor-pointer items-center justify-between gap-1 text-left font-semibold whitespace-normal"
            type="button"
            data-sort-type="text"
          >
            <span>Name</span>
            <span class="iconify lucide--chevrons-up-down"></span>
          </button>
        </th>
        <th class="hidden @2xl:table-cell" scope="col">
          <button
            class="hover:text-primary flex w-full cursor-pointer items-center justify-between gap-1 text-left font-semibold whitespace-normal"
            type="button"
            data-sort-type="text"
          >
            <span>Fraktion</span>
            <span class="iconify lucide--chevrons-up-down"></span>
          </button>
        </th>
        <th class="hidden @4xl:table-cell" scope="col">
          <button
            class="hover:text-primary flex w-full cursor-pointer items-center justify-between gap-1 text-left font-semibold whitespace-normal"
            type="button"
            data-sort-type="text"
          >
            <span>Partei</span>
            <span class="iconify lucide--chevrons-up-down"></span>
          </button>
        </th>
        <th class="text-right" scope="col" aria-sort="descending">
          <button
            class="hover:text-primary flex w-full cursor-pointer items-center justify-end gap-1 font-semibold whitespace-normal"
            type="button"
            data-sort-type="number"
          >
            <span class="text-right">Übereinstimmung</span>
            <span class="iconify lucide--chevrons-up-down"></span>
          </button>
        </th>
      </tr>
    </thead>
    <tbody>
      {votingMatrix.map((item) => (
        <tr>
          <th
            scope="row"
            class="bg-base-100 font-normal"
            data-sort-value={nameForSorting(item.personName)}
          >
            <a
              href={siteRoutes(parliamentPeriodId).person(item.personId)}
              class="link link-hover link-primary"
            >
              {item.personName}
            </a>
          </th>
          <td class="hidden @2xl:table-cell">
            <a
              href={siteRoutes(parliamentPeriodId).faction(item.factionId)}
              class="link link-hover link-primary"
            >
              {item.factionName}
            </a>
          </td>
          <td class="hidden @4xl:table-cell">
            <a
              href={siteRoutes(parliamentPeriodId).party(item.partyId)}
              class="link link-hover link-primary"
            >
              {item.partyName}
            </a>
          </td>
          <td
            class="text-right whitespace-nowrap tabular-nums"
            data-sort-value={sortValue(item.comparisonScore)}
          >
            {item.comparisonScoreDisplay}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="text-base-content/70 px-4 py-3 text-xs @4xl:hidden">
    Weitere Kennzahlen zeigt die Tabelle auf größeren Bildschirmen.
  </p>
</div>

<script>
  import { makeTablesSortable } from '@utils/sortable-table';

  makeTablesSortable();
</script>
