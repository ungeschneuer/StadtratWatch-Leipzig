---
import { siteRoutes } from '@utils/routes';
import PageLayout from '@layouts/PageLayout.astro';
import {
  type ParliamentPeriodWithSessionsProps,
  getParliamentPeriodWithSessionsPaths,
} from '../_helpers';
import { type BreadcrumbItem } from '@components/BreadcrumbMenu.astro';
import { formatDate } from '@utils/format-date';
import { formatNumber } from '@utils/format-number';

export const getStaticPaths = getParliamentPeriodWithSessionsPaths;

const { parliamentPeriod, sessionInputs } =
  Astro.props as ParliamentPeriodWithSessionsProps;
const routes = siteRoutes(parliamentPeriod.id);

const newestFirst = sessionInputs.toSorted(
  (a, b) =>
    new Date(b.session.date).getTime() - new Date(a.session.date).getTime(),
);
const months = Array.from(
  Map.groupBy(newestFirst, (sessionInput) =>
    new Date(sessionInput.session.date).toLocaleString('de-DE', {
      month: 'long',
      year: 'numeric',
    }),
  ),
  ([label, monthSessionInputs]) => ({
    label,
    sessions: monthSessionInputs.map((sessionInput) => ({
      url: routes.session(sessionInput.session.id),
      dateDisplay: formatDate(sessionInput.session.date),
      title: sessionInput.session.title,
      approved: sessionInput.session.approved,
      votingCount: sessionInput.votings.length,
    })),
  }),
);

function describeVotingCount(count: number): string {
  if (count === 0) return 'keine Abstimmungen über die Tafel';
  return `${formatNumber(count)} ${count === 1 ? 'Abstimmung' : 'Abstimmungen'}`;
}

const breadcrumbItems: BreadcrumbItem[] = [
  {
    name: parliamentPeriod.name,
    href: routes.parliamentPeriod(),
  },
  {
    name: 'Sitzungen',
    href: null,
  },
];
---

<PageLayout
  pageTitle="Sitzungen"
  parliamentPeriod={parliamentPeriod}
  breadcrumbItems={breadcrumbItems}
>
  <div class="max-w-3xl space-y-8">
    {months.map((month) => (
      <section>
        <h2 class="text-base-content/70 text-sm font-semibold">
          {month.label}
        </h2>
        <ul class="divide-base-300 border-base-300 mt-2 divide-y border-y">
          {month.sessions.map((session) => (
            <li class="py-3">
              <a href={session.url} class="link-quiet font-medium">
                {session.dateDisplay}
                {session.title && `: ${session.title}`}
              </a>
              <p class="text-base-content/70 mt-1 text-sm">
                {describeVotingCount(session.votingCount)}
                {!session.approved && (
                  <>
                    ,{' '}
                    <span class="text-warning">
                      Prüfung noch nicht abgeschlossen
                    </span>
                  </>
                )}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</PageLayout>
