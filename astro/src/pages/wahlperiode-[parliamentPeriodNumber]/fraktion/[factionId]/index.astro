---
import { siteRoutes } from '@utils/routes';
import PageLayout from '@layouts/PageLayout.astro';
import {
  type ParliamentPeriodWithFactionProps,
  getParliamentPeriodWithFactionPaths,
} from '../../_helpers';
import Councilors from './_councilors.astro';
import Motions from './_motions.astro';
import Statistics from './_statistics.astro';
import MetaTags from '@components/MetaTags.astro';

export const getStaticPaths = getParliamentPeriodWithFactionPaths;

const { factionId } = Astro.params;
const { parliamentPeriod, faction, sessionInputs } =
  Astro.props as ParliamentPeriodWithFactionProps;
const parliamentPeriodId = parliamentPeriod.id;

const breadcrumbItems = [
  {
    name: parliamentPeriod.name,
    href: siteRoutes(parliamentPeriodId).parliamentPeriod(),
  },
  {
    name: 'Fraktionen',
    href: siteRoutes(parliamentPeriodId).factions(),
  },
  {
    name: faction.name,
    href: null,
  },
];
---

<PageLayout
  parliamentPeriod={parliamentPeriod}
  pageTitle={faction.name}
  breadcrumbItems={breadcrumbItems}
>
  <MetaTags slot="srw-meta-tags" factionName={faction.name} />

  <div
    id="tabs"
    role="group"
    aria-label="Ansicht"
    class="tabs tabs-lift"
    x-data="faction"
    data-parliament-period-id={parliamentPeriodId}
    data-faction-id={factionId}
  >
    <input
      class="tab"
      aria-label="Ratsmitglieder"
      type="radio"
      name="faction-tabs-radio"
      :checked="currentTab === 'councilors'"
      @change="history.pushState(null, '', '?tab=councilors'); currentTab = 'councilors'"
    />
    <div class="tab-content border-base-200 bg-base-100 p-3 sm:p-6">
      <Councilors
        parliamentPeriod={parliamentPeriod}
        faction={faction}
        sessionInputs={sessionInputs}
      />
    </div>

    <input
      class="tab"
      aria-label="Anträge"
      type="radio"
      name="faction-tabs-radio"
      :checked="currentTab === 'motions'"
      @change="history.pushState(null, '', '?tab=motions'); currentTab = 'motions'"
    />
    <div class="tab-content border-base-200 bg-base-100 p-3 sm:p-6">
      <Motions
        parliamentPeriod={parliamentPeriod}
        faction={faction}
        sessionInputs={sessionInputs}
      />
    </div>

    <input
      class="tab"
      aria-label="Statistiken"
      type="radio"
      name="faction-tabs-radio"
      :checked="currentTab === 'statistics'"
      @change="history.pushState(null, '', '?tab=statistics'); currentTab = 'statistics'"
    />
    <div class="tab-content border-base-200 bg-base-100 p-3 sm:p-6">
      <Statistics
        parliamentPeriod={parliamentPeriod}
        faction={faction}
        sessionInputs={sessionInputs}
      />
    </div>
  </div>
</PageLayout>

<script>
  import Alpine from 'alpinejs';

  document.addEventListener('alpine:init', () => {
    const currentUrl = new URL(window.location.href);
    const currentTab = currentUrl.searchParams.get('tab') || 'councilors';

    const sessionsDivElement = document.getElementById(
      'tabs',
    ) as HTMLDivElement;
    const parliamentPeriodId = sessionsDivElement.dataset.parliamentPeriodId;
    const factionId = sessionsDivElement.dataset.factionId;
    Alpine.data('faction', () => ({
      parliamentPeriodId,
      factionId,
      currentTab,
    }));
  });
</script>
