---
import { siteRoutes, votingSlugs } from '@utils/routes';
import { type SessionInput } from '@models/SessionInput';
import { type Registry, type RegistryFaction } from '@models/registry';
import { type MotionResult, getMotionResult, getVotingId } from './_helpers';
import { votingAccepted } from '@models/voting-breakdown';
import { formatDate } from '@utils/format-date';

export type MotionListItem = {
  sessionId: string;
  votingId: number;
  votingDate: string;
  votingDateFormatted: string;
  type: string | null;
  motionId: string;
  paperUrl: string | null;
  votingUrl: string;
  title: string;
  result: MotionResult;
};

type Props = {
  parliamentPeriod: Registry;
  faction: RegistryFaction;
  sessionInputs: SessionInput[];
};

const { parliamentPeriod, faction, sessionInputs } = Astro.props as Props;
const routes = siteRoutes(parliamentPeriod.id);
const votingSlugsBySession = new Map(
  sessionInputs.map((sessionInput) => [
    sessionInput.session.id,
    votingSlugs(sessionInput.votings),
  ]),
);

const factionMotionVotings = sessionInputs
  .flatMap((sessionInput) =>
    sessionInput.votings.map((voting) => ({
      voting,
      sessionId: sessionInput.session.id,
      sessionDate: sessionInput.session.date,
    })),
  )
  .filter((voting) => !!voting.voting.votingSubject.motionId)
  .filter((voting) =>
    voting.voting.votingSubject.authors.includes(faction.name),
  );
const motionsMap = Map.groupBy(
  factionMotionVotings,
  (voting) =>
    `${voting.voting.votingSubject.motionId}-${voting.voting.votingSubject.type}`,
);
const motions = Array.from(motionsMap)
  .map(([_, motionVotings]) => {
    const motionVoting = motionVotings[0];
    const motionId = motionVoting.voting.votingSubject.motionId;
    const motionType = motionVoting.voting.votingSubject.type;
    const motionTitle = motionVoting.voting.votingSubject.title;
    const sessionId = motionVoting.sessionId;
    const sessionDate = motionVoting.sessionDate;
    const paperUrl = motionVoting.voting.votingSubject.paperUrl ?? null;
    const votings = motionVotings.map((motionVoting) => ({
      votingId: +motionVoting.voting.votingFilename.substring(11, 14),
      votingFilename: motionVoting.voting.votingFilename,
      accepted: votingAccepted(parliamentPeriod, motionVoting.voting),
    }));
    return {
      motionId,
      type: motionType,
      title: motionTitle,
      sessionId,
      sessionDate,
      paperUrl,
      votings,
    };
  })
  .toSorted((a, b) => b.sessionDate.localeCompare(a.sessionDate))
  .map<MotionListItem>((motion) => {
    const votingId = getVotingId(motion.votings);
    const votingFilename = motion.votings.find(
      (voting) => voting.votingId === votingId,
    )?.votingFilename as string;
    return {
      sessionId: motion.sessionId,
      votingId,
      votingDate: motion.sessionDate,
      votingDateFormatted: formatDate(motion.sessionDate),
      type: motion.type,
      motionId: motion.motionId,
      paperUrl: motion.paperUrl,
      votingUrl: routes.voting(
        motion.sessionId,
        votingSlugsBySession
          .get(motion.sessionId)
          ?.get(votingFilename) as string,
      ),
      title: motion.title,
      result: getMotionResult(motion.votings),
    } satisfies MotionListItem;
  });

const MOTION_RESULTS: Record<
  MotionResult,
  { label: string; className: string }
> = {
  ACCEPTED: { label: 'angenommen', className: 'text-success' },
  PARTIALLY_ACCEPTED: { label: 'teilweise', className: 'text-warning' },
  REJECTED: { label: 'abgelehnt', className: 'text-error' },
};
---

<div class="@container space-y-4">
  <div class="flex flex-row flex-wrap gap-4">
    <div class="flex items-center gap-2">
      <input
        class="toggle toggle-sm"
        id="motions-filter-0"
        type="checkbox"
        checked
        data-motion-type-filter="Antrag"
      />
      <label class="label text-sm" for="motions-filter-0">
        Anträge
      </label>
    </div>
    <div class="flex items-center gap-2">
      <input
        class="toggle toggle-sm"
        id="motions-filter-1"
        type="checkbox"
        checked
        data-motion-type-filter="Änderungsantrag"
      />
      <label class="label text-sm" for="motions-filter-1">
        Änderungsanträge
      </label>
    </div>
    <div class="flex items-center gap-2">
      <input
        class="toggle toggle-sm"
        id="motions-filter-2"
        type="checkbox"
        checked
        data-motion-type-filter="Geschäftsordnung"
      />
      <label class="label text-sm" for="motions-filter-2">
        Geschäftsordnungsanträge
      </label>
    </div>
  </div>
  <div class="overflow-x-auto">
    <table data-sortable class="table table-sm md:table-md">
      <thead>
        <tr>
          <th class="hidden @xl:table-cell" scope="col" aria-sort="descending">
            <button
              type="button"
              data-sort-type="text"
              class="hover:text-primary flex w-full cursor-pointer items-center justify-between gap-1 text-left font-semibold whitespace-normal"
            >
              <span>Abgestimmt am</span>
              <span
                class="iconify lucide--chevrons-up-down"
                aria-hidden="true"
              ></span>
            </button>
          </th>
          <th class="hidden @2xl:table-cell" scope="col">
            <button
              type="button"
              data-sort-type="text"
              class="hover:text-primary flex w-full cursor-pointer items-center justify-between gap-1 text-left font-semibold whitespace-normal"
            >
              <span>Antrag</span>
              <span
                class="iconify lucide--chevrons-up-down"
                aria-hidden="true"
              ></span>
            </button>
          </th>
          <th scope="col">
            <button
              type="button"
              data-sort-type="text"
              class="hover:text-primary flex w-full cursor-pointer items-center justify-between gap-1 text-left font-semibold whitespace-normal"
            >
              <span>Titel</span>
              <span
                class="iconify lucide--chevrons-up-down"
                aria-hidden="true"
              ></span>
            </button>
          </th>
          <th scope="col">
            <button
              type="button"
              data-sort-type="text"
              class="hover:text-primary flex w-full cursor-pointer items-center justify-between gap-1 text-left font-semibold whitespace-normal"
            >
              <span>Ergebnis</span>
              <span
                class="iconify lucide--chevrons-up-down"
                aria-hidden="true"
              ></span>
            </button>
          </th>
        </tr>
      </thead>
      <tbody>
        {motions.map((motion) => (
          <tr data-motion-type={motion.type}>
            <td
              class="hidden @xl:table-cell whitespace-nowrap"
              data-sort-value={motion.votingDate}
            >
              {motion.votingDateFormatted}
            </td>
            <td
              class="hidden @2xl:table-cell"
              data-sort-value={motion.motionId}
            >
              <span class="block">{motion.type}</span>
              {motion.paperUrl ? (
                <a
                  href={motion.paperUrl}
                  target="_blank"
                  class="link link-hover link-primary block wrap-anywhere"
                  title="Drucksache im Ratsinformationssystem der Stadt Leipzig"
                >
                  Drucksache {motion.motionId}
                </a>
              ) : (
                <span class="block">{motion.motionId}</span>
              )}
            </td>
            <td class="hyphens-auto">
              <a href={motion.votingUrl} class="link link-hover link-primary">
                {motion.title}
              </a>
            </td>
            <td
              class:list={[
                'whitespace-nowrap',
                MOTION_RESULTS[motion.result].className,
              ]}
            >
              {MOTION_RESULTS[motion.result].label}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  import { makeTablesSortable } from '@utils/sortable-table';

  makeTablesSortable();

  const typeFilters = document.querySelectorAll<HTMLInputElement>(
    'input[data-motion-type-filter]',
  );
  const motionRows = document.querySelectorAll<HTMLTableRowElement>(
    'tr[data-motion-type]',
  );

  function showSelectedMotionTypes() {
    const hiddenTypes = new Set(
      [...typeFilters]
        .filter((filter) => !filter.checked)
        .map((filter) => filter.dataset.motionTypeFilter),
    );
    motionRows.forEach((row) => {
      row.hidden = hiddenTypes.has(row.dataset.motionType);
    });
  }

  typeFilters.forEach((filter) =>
    filter.addEventListener('change', showSelectedMotionTypes),
  );
</script>
