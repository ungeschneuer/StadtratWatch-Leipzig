---
import StatisticsTable, {
  type StatisticsMeasure,
} from '@components/StatisticsTable.astro';
import { type RegistryFaction } from '@models/registry';
import { type SessionInput } from '@models/SessionInput';
import {
  calcMotionsSuccessRateOfFaction,
  calcMotionsSuccessRateHistoryOfFaction,
} from '@data-analysis/MotionsSuccess';
import {
  calcVotingSuccessRateOfFaction,
  calcVotingSuccessRateHistoryOfFaction,
} from '@data-analysis/VotingSuccess';
import {
  calcUniformityScoreHistoryOfFaction,
  calcUniformityScoreOfFaction,
} from '@data-analysis/UniformityScore';
import {
  calcParticipationRateHistoryOfFaction,
  calcParticipationRateOfFaction,
} from '@data-analysis/ParticipationRate';
import {
  calcAbstentionRateHistoryOfFaction,
  calcAbstentionRateOfFaction,
} from '@data-analysis/AbstentionRate';
import { formatPercentage, formatScore } from '@utils/format-number';
import { calcSeatsHistoryOfFaction } from '@data-analysis/Seats';
import { formatDate } from '@utils/format-date';
import { type Registry } from '@models/registry';

type Props = {
  parliamentPeriod: Registry;
  faction: RegistryFaction;
  sessionInputs: SessionInput[];
};

const { parliamentPeriod, faction, sessionInputs } = Astro.props as Props;

const motionsSuccessRate = calcMotionsSuccessRateOfFaction(
  parliamentPeriod,
  faction,
  sessionInputs,
);
const motionsSuccessRateHistory = calcMotionsSuccessRateHistoryOfFaction(
  parliamentPeriod,
  faction,
  sessionInputs,
);
const votingsSuccessRate = calcVotingSuccessRateOfFaction(
  parliamentPeriod,
  faction,
  sessionInputs,
);
const votingsSuccessRateHistory = calcVotingSuccessRateHistoryOfFaction(
  parliamentPeriod,
  faction,
  sessionInputs,
);
const uniformityScore = calcUniformityScoreOfFaction(
  parliamentPeriod,
  faction,
  sessionInputs,
);
const uniformityScoreHistory = calcUniformityScoreHistoryOfFaction(
  parliamentPeriod,
  faction,
  sessionInputs,
);
const participationRate = calcParticipationRateOfFaction(
  parliamentPeriod,
  faction,
  sessionInputs,
);
const participationRateHistory = calcParticipationRateHistoryOfFaction(
  parliamentPeriod,
  faction,
  sessionInputs,
);
const abstentionRate = calcAbstentionRateOfFaction(
  parliamentPeriod,
  faction,
  sessionInputs,
);
const abstentionRateHistory = calcAbstentionRateHistoryOfFaction(
  parliamentPeriod,
  faction,
  sessionInputs,
);
const seatsHistory = calcSeatsHistoryOfFaction(
  parliamentPeriod,
  faction,
  sessionInputs,
);

const measures: StatisticsMeasure[] = [
  {
    id: 'seats',
    label: 'Sitze',
    value: String(faction.seats),
    explanation:
      'Sitze heute. Ändern sie sich durch Nachrückende, Austritte oder Wechsel, steht darunter der Stand an den Sitzungen mit einer Änderung.',
    detail:
      seatsHistory.length > 1
        ? seatsHistory
            .map((point) => `${formatDate(point.date)}: ${point.value}`)
            .join('; ')
        : undefined,
  },
  {
    id: 'motions-success-rate',
    label: 'Erfolgreiche Anträge',
    value: formatPercentage(motionsSuccessRate),
    explanation:
      'Anteil der Anträge der Fraktion, die mit Mehrheit angenommen wurden.',
    history: motionsSuccessRateHistory,
  },
  {
    id: 'voting-success-rate',
    label: 'Abstimmungserfolg',
    value: formatPercentage(votingsSuccessRate),
    explanation:
      'Wie häufig das Abstimmungsergebnis mit dem Votum der Fraktion übereinstimmte.',
    history: votingsSuccessRateHistory,
  },
  {
    id: 'uniformity-score',
    label: 'Geschlossenheit',
    value: formatScore(uniformityScore),
    explanation:
      'Ein Wert zwischen 0 und 1: wie einheitlich die Fraktionsmitglieder abgestimmt haben. Je größer, desto geschlossener.',
    history: uniformityScoreHistory,
    format: 'score',
  },
  {
    id: 'participation-rate',
    label: 'Abstimmungsteilnahme',
    value: formatPercentage(participationRate),
    explanation:
      'Wie häufig die Fraktionsmitglieder an Abstimmungen teilgenommen haben.',
    history: participationRateHistory,
  },
  {
    id: 'abstention-rate',
    label: 'Stimmenthaltungen',
    value: formatPercentage(abstentionRate),
    explanation:
      'Anteil der abgegebenen Stimmen, die weder dafür noch dagegen waren.',
    history: abstentionRateHistory,
  },
];
---

<StatisticsTable measures={measures} />
