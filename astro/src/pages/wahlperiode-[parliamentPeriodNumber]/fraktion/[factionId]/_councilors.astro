---
import { siteRoutes } from '@utils/routes';
import { type SessionInput } from '@models/SessionInput';
import { personsWithRecordedVotes } from '@data-analysis/RecordedVotes';
import { type Registry, type RegistryFaction } from '@models/registry';
import { affiliationMembers, factionHistory } from '@models/person-affiliation';
import CouncilorList, { type Councilor } from '@components/CouncilorList.astro';
import { formatPeriod } from '@utils/format-period';

type Props = {
  parliamentPeriod: Registry;
  sessionInputs: SessionInput[];
  faction: RegistryFaction;
};

const { parliamentPeriod, faction, sessionInputs } = Astro.props as Props;

// Everyone who belonged to the faction in the period; members who changed show when they belonged to it.
const councilors: Councilor[] = affiliationMembers(
  personsWithRecordedVotes(parliamentPeriod, sessionInputs),
  factionHistory,
  faction.id,
).map(({ person, periods, isCurrent, changed }) => ({
  url: siteRoutes(parliamentPeriod.id).person(person.id),
  name: person.name,
  end: person.end,
  otherAffiliation: getPartyName(person.partyId),
  isCurrent,
  membershipPeriods: changed
    ? periods.map((period) => formatPeriod(period.start, period.end)).join(', ')
    : null,
}));

function getPartyName(partyId: string) {
  const party = parliamentPeriod.parties.find((party) => party.id === partyId);
  return party ? party.name : '';
}
---

<CouncilorList councilors={councilors} membershipLabel="In der Fraktion" />
