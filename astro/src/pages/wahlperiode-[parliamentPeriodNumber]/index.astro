---
import Layout from '@layouts/Layout.astro';
import VotingReviewBadge from '@components/VotingReviewBadge.astro';
import {
  type ParliamentPeriodWithSessionsProps,
  getParliamentPeriodWithSessionsPaths,
} from './_helpers';
import { formatDate } from '@utils/format-date';
import { formatNumber } from '@utils/format-number';
import { calcSpeakingTimeOfSessions } from '@data-analysis/SpeakingTime';
import { getVoteCounts, votingAccepted } from '@models/voting-breakdown.ts';
import { siteRoutes, votingSlugs } from '@utils/routes';
import { sitePath } from '@utils/site-path';
import {
  factionColorProperty,
  factionColorStyles,
  factionColorsByParliamentPeriod,
} from '@utils/faction-colors';

export const getStaticPaths = getParliamentPeriodWithSessionsPaths;

const { parliamentPeriod, sessionInputs } =
  Astro.props as ParliamentPeriodWithSessionsProps;
const routes = siteRoutes(parliamentPeriod.id);
const firstSession = parliamentPeriod.sessions[0];

const allVotings = sessionInputs.flatMap(
  (sessionInput) => sessionInput.votings,
);
const castVoteCount = allVotings.reduce(
  (sum, voting) =>
    sum + voting.votes.filter((vote) => vote.vote !== 'O').length,
  0,
);
const speakingHours = Math.round(
  calcSpeakingTimeOfSessions(sessionInputs) / 3600,
);

// Seats in the order of size; a semicircle would suggest a left-right order the council does not have.
const factionColors =
  factionColorsByParliamentPeriod.get(parliamentPeriod.id) ?? new Map();
const colorPropertyByFaction = new Map(
  [...factionColors.keys()].map((faction, index) => [
    faction,
    factionColorProperty(index),
  ]),
);
const seatRows = parliamentPeriod.factions
  .filter((faction) => faction.seats > 0)
  .toSorted((a, b) => b.seats - a.seats)
  .map((faction) => ({
    ...faction,
    color: colorPropertyByFaction.has(faction.name)
      ? `var(${colorPropertyByFaction.get(faction.name)})`
      : 'var(--color-neutral)',
  }));
const seatCount = seatRows.reduce((sum, faction) => sum + faction.seats, 0);

// The latest session with votes on the substance of a matter, not on the agenda or procedure.
const SUBSTANTIVE_TYPES = ['Beschlussvorlage', 'Antrag', 'Änderungsantrag'];
const latestSessionInput = sessionInputs.findLast(
  (sessionInput) => sessionInput.votings.length > 0,
);
const latestVotings = latestSessionInput
  ? (() => {
      const slugs = votingSlugs(latestSessionInput.votings);
      return latestSessionInput.votings
        .filter((voting) =>
          SUBSTANTIVE_TYPES.includes(voting.votingSubject.type ?? ''),
        )
        .slice(-4)
        .reverse()
        .map((voting) => ({
          title: voting.votingSubject.title,
          agendaItem: voting.votingSubject.agendaItem,
          type: voting.votingSubject.type,
          counts: getVoteCounts(voting),
          accepted: votingAccepted(parliamentPeriod, voting),
          reviewStatus: voting.reviewStatus,
          url: routes.voting(
            latestSessionInput.session.id,
            slugs.get(voting.votingFilename) as string,
          ),
        }));
    })()
  : [];

function countOf(count: number, singular: string, plural: string): string {
  return `${formatNumber(count)} ${count === 1 ? singular : plural}`;
}
---

<Layout parliamentPeriod={parliamentPeriod}>
  <style is:inline set:html={factionColorStyles(factionColors)}></style>

  <div class="space-y-10 lg:space-y-12">
    <section class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] lg:gap-12">
      <div class="max-w-xl">
        <h1 class="text-3xl leading-tight font-bold text-balance sm:text-4xl">
          Abstimmungen im Leipziger Stadtrat
        </h1>
        <p class="mt-4 text-lg text-pretty">
          Seit dem {formatDate(firstSession.date)} hat die Ratsversammlung in{' '}
          {countOf(sessionInputs.length, 'Sitzung', 'Sitzungen')}{' '}
          {formatNumber(allVotings.length)}-mal über die elektronische Tafel
          abgestimmt. Hier steht jede der {formatNumber(castVoteCount)} Stimmen
          mit Namen, gelesen aus den Aufzeichnungen der Stadt und mit ihren
          Protokollen abgeglichen, dazu {formatNumber(speakingHours)} Stunden
          Redebeiträge.
        </p>
        <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
          {latestSessionInput && (
            <a
              href={routes.session(latestSessionInput.session.id)}
              class="btn btn-primary"
            >
              Sitzung vom {formatDate(latestSessionInput.session.date)}
            </a>
          )}
          <a href={sitePath('/suche')} class="link link-primary">
            Nach Person oder Thema suchen
          </a>
        </p>
      </div>

      <figure
        class="card border-base-300 bg-base-100 border"
        aria-labelledby="seats-caption"
      >
        <div class="card-body gap-3 p-5">
          <figcaption
            id="seats-caption"
            class="flex items-baseline justify-between"
          >
            <span class="font-semibold">Sitzverteilung</span>
            <span class="text-base-content/70 text-sm">{seatCount} Sitze</span>
          </figcaption>
          <ul class="space-y-2">
            {seatRows.map((faction) => (
              <li>
                <a
                  href={routes.faction(faction.id)}
                  class="hover:bg-base-200 -mx-2 grid grid-cols-[7rem_minmax(0,1fr)_auto] sm:grid-cols-[10rem_minmax(0,1fr)_auto] items-center gap-3 rounded-field px-2 py-1"
                >
                  <span class="text-sm leading-tight hyphens-auto" lang="de">
                    {faction.name}
                  </span>
                  <span
                    class="flex flex-wrap gap-[2px] min-[400px]:gap-[3px] sm:gap-1"
                    aria-hidden="true"
                  >
                    {Array.from({ length: faction.seats }, () => (
                      <span
                        class="size-[7px] rounded-full min-[400px]:size-2 sm:size-2.5"
                        style={`background-color: ${faction.color};`}
                      />
                    ))}
                  </span>
                  <span class="text-sm tabular-nums">
                    {faction.seats}
                    <span class="sr-only"> Sitze</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </figure>
    </section>

    {latestSessionInput && latestVotings.length > 0 && (
      <section aria-labelledby="latest-heading" class="max-w-4xl">
        <h2 id="latest-heading" class="text-xl font-semibold">
          Zuletzt abgestimmt
        </h2>
        <p class="text-base-content/70 mt-1 text-sm">
          Die letzten Beschlussvorlagen und Anträge der Sitzung vom{' '}
          <a href={routes.session(latestSessionInput.session.id)} class="link">
            {formatDate(latestSessionInput.session.date)}
          </a>
          .
        </p>
        <ul class="divide-base-300 border-base-300 mt-4 divide-y border-y">
          {latestVotings.map((voting) => (
            <li class="py-3">
              <a
                href={voting.url}
                class="link-quiet font-medium hyphens-auto"
                lang="de"
              >
                {voting.title}
              </a>
              <p class="text-base-content/70 mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                <span>
                  TOP {voting.agendaItem}
                  {voting.type && `, ${voting.type}`}:
                </span>
                <span
                  class:list={[
                    'font-semibold',
                    voting.accepted ? 'text-success' : 'text-error',
                  ]}
                >
                  {voting.accepted ? 'angenommen' : 'abgelehnt'}
                </span>
                <span class="tabular-nums">
                  mit {countOf(voting.counts.J, 'Ja-Stimme', 'Ja-Stimmen')},{' '}
                  {countOf(voting.counts.N, 'Nein-Stimme', 'Nein-Stimmen')} und{' '}
                  {countOf(voting.counts.E, 'Enthaltung', 'Enthaltungen')}
                </span>
                <VotingReviewBadge reviewStatus={voting.reviewStatus} />
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section aria-labelledby="method-heading" class="max-w-prose">
      <h2 id="method-heading" class="text-xl font-semibold">
        Woher die Daten kommen
      </h2>
      <p class="mt-3">
        Die Stadt stellt jede Ratsversammlung als Video in ihre{' '}
        <a href="https://www.leipzig.de/mediathek" class="link">
          Mediathek
        </a>
        . Aus dem Bild der Abstimmungstafel wird jede Stimme nach ihrer Farbe
        gelesen und mit den Protokollen im{' '}
        <a
          href="https://ratsinformation.leipzig.de/allris_leipzig_public/"
          class="link"
        >
          Ratsinformationssystem
        </a>{' '}
        abgeglichen. Was nicht zusammenpasst, sieht sich ein Mensch an; solange
        das nicht geschehen ist, steht an der Abstimmung „vorläufig“ oder „in
        Prüfung“.
      </p>
      <p class="text-base-content/70 mt-3 text-sm">
        Erfasst sind nur Sitzungen, deren Aufzeichnung noch online ist (die
        Stadt hält sie etwa ein Jahr vor), und nur Abstimmungen über die
        elektronische Tafel. Abstimmungen per Handzeichen und geheime Wahlen
        haben keine Stimmen je Person. Mehr unter{' '}
        <a href={sitePath('/kontakt')} class="link">
          Kontakt
        </a>
        .
      </p>
    </section>
  </div>
</Layout>
