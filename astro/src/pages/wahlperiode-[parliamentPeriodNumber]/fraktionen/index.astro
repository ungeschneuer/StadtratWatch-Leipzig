---
import { siteRoutes } from '@utils/routes';
import PageLayout from '@layouts/PageLayout.astro';
import {
  type ParliamentPeriodWithSessionsProps,
  getParliamentPeriodWithSessionsPaths,
} from '../_helpers';
import { calcMotionsSuccessRateOfFaction } from '@data-analysis/MotionsSuccess';
import { calcVotingSuccessRateOfFaction } from '@data-analysis/VotingSuccess';
import { calcUniformityScoreOfFaction } from '@data-analysis/UniformityScore';
import { calcParticipationRateOfFaction } from '@data-analysis/ParticipationRate';
import { calcAbstentionRateOfFaction } from '@data-analysis/AbstentionRate';
import { calcSpeakingTimeOfFaction } from '@data-analysis/SpeakingTime';
import {
  formatAbstentionRate,
  formatMotionsSuccessRate,
  formatParticipationRate,
  formatUniformityScore,
  formatVotingSuccessRate,
} from '@utils/format-number';
import { formatSpeakingTime } from '@utils/format-time';
import { type ChartDataPoint, type FactionListItem } from './_models';
import { type BreadcrumbItem } from '@components/BreadcrumbMenu.astro';

export const getStaticPaths = getParliamentPeriodWithSessionsPaths;

const { parliamentPeriod, sessionInputs } =
  Astro.props as ParliamentPeriodWithSessionsProps;
const parliamentPeriodId = parliamentPeriod.id;

const breadcrumbItems: BreadcrumbItem[] = [
  {
    name: parliamentPeriod.name,
    href: siteRoutes(parliamentPeriodId).parliamentPeriod(),
  },
  {
    name: 'Fraktionen',
    href: null,
  },
];

const factions = parliamentPeriod.factions
  .map<FactionListItem>((faction) => {
    const motionsSuccessRate = calcMotionsSuccessRateOfFaction(
      parliamentPeriod,
      faction,
      sessionInputs,
    );
    const votingSuccessRate = calcVotingSuccessRateOfFaction(
      parliamentPeriod,
      faction,
      sessionInputs,
    );
    const uniformityScore = calcUniformityScoreOfFaction(
      parliamentPeriod,
      faction,
      sessionInputs,
    );
    const participationRate = calcParticipationRateOfFaction(
      parliamentPeriod,
      faction,
      sessionInputs,
    );
    const abstentionRate = calcAbstentionRateOfFaction(
      parliamentPeriod,
      faction,
      sessionInputs,
    );
    const speakingTime = calcSpeakingTimeOfFaction(
      parliamentPeriod,
      faction,
      sessionInputs,
    );
    return {
      id: faction.id,
      name: faction.name,
      seats: faction.seats,
      motionsSuccessRate,
      motionsSuccessRateDisplay: formatMotionsSuccessRate(motionsSuccessRate),
      votingSuccessRate,
      votingSuccessRateDisplay: formatVotingSuccessRate(votingSuccessRate),
      uniformityScore,
      uniformityScoreDisplay: formatUniformityScore(uniformityScore),
      participationRate,
      participationRateDisplay: formatParticipationRate(participationRate),
      abstentionRate,
      abstentionRateDisplay: formatAbstentionRate(abstentionRate),
      speakingTime,
      speakingTimeDisplay: formatSpeakingTime(speakingTime),
    } satisfies FactionListItem;
  })
  .toSorted((a, b) => b.seats - a.seats);

const votingSuccessRateChartData: ChartDataPoint[] = factions
  .map((faction) => ({
    value: faction.votingSuccessRate || 0,
    factionId: faction.id,
    label: faction.name,
    valueLabel: faction.votingSuccessRateDisplay,
  }))
  .toSorted((a, b) => b.value - a.value);

const uniformityScoreChartData: ChartDataPoint[] = factions
  .map((faction) => ({
    value: faction.uniformityScore || 0,
    factionId: faction.id,
    label: faction.name,
    valueLabel: faction.uniformityScoreDisplay,
  }))
  .toSorted((a, b) => b.value - a.value);

const participationRateChartData: ChartDataPoint[] = factions
  .map((faction) => ({
    value: faction.participationRate || 0,
    factionId: faction.id,
    label: faction.name,
    valueLabel: faction.participationRateDisplay,
  }))
  .toSorted((a, b) => b.value - a.value);

const abstentionRateChartData: ChartDataPoint[] = factions
  .map((faction) => ({
    value: faction.abstentionRate || 0,
    factionId: faction.id,
    label: faction.name,
    valueLabel: faction.abstentionRateDisplay,
  }))
  .toSorted((a, b) => b.value - a.value);

const motionsSuccessRateChartData: ChartDataPoint[] = factions
  .map((faction) => ({
    value: faction.motionsSuccessRate || 0,
    factionId: faction.id,
    label: faction.name,
    valueLabel: faction.motionsSuccessRateDisplay,
  }))
  .toSorted((a, b) => b.value - a.value);

const speakingTimesChartData: ChartDataPoint[] = factions
  .map((faction) => ({
    value: faction.speakingTime,
    factionId: faction.id,
    label: faction.name,
    valueLabel: faction.speakingTimeDisplay,
  }))
  .toSorted((a, b) => b.value - a.value);

const barHeight = factions.length * 40;
---

<PageLayout
  pageTitle="Fraktionen"
  parliamentPeriod={parliamentPeriod}
  breadcrumbItems={breadcrumbItems}
>
  <div class="space-y-3">
    <div class="bg-base-100 border border-base-200 rounded-box">
      <div class="@container overflow-x-auto">
        <table
          class="table table-sm md:table-md table-pin-cols"
          x-data="factions"
          data-parliament-period-id={parliamentPeriod.id}
          data-factions={JSON.stringify(factions)}
        >
          <thead>
            <tr>
              <th>
                <button
                  class="hover:text-primary flex w-full cursor-pointer items-center justify-between gap-1 text-left font-semibold whitespace-normal"
                  @click="sortTextColumn('name', (faction) => faction.name)"
                >
                  <span>Name</span>
                  <span class="iconify lucide--chevrons-up-down"></span>
                </button>
              </th>
              <th class="hidden @[22rem]:table-cell text-right">
                <button
                  class="hover:text-primary flex w-full cursor-pointer items-center justify-end gap-1 font-semibold whitespace-normal"
                  @click="sortNumberColumn('seats', (faction) => faction.seats)"
                >
                  <span>Sitze</span>
                  <span class="iconify lucide--chevrons-up-down"></span>
                </button>
              </th>
              <th class="text-right">
                <button
                  class="hover:text-primary flex w-full cursor-pointer items-center justify-end gap-1 font-semibold whitespace-normal"
                  @click="sortNumberColumn('votingSuccessRate', (faction) => faction.votingSuccessRate)"
                >
                  <span>Abstimmungs&shy;erfolg</span>
                  <span class="iconify lucide--chevrons-up-down"></span>
                </button>
              </th>
              <th class="hidden @2xl:table-cell text-right">
                <button
                  class="hover:text-primary flex w-full cursor-pointer items-center justify-end gap-1 font-semibold whitespace-normal"
                  @click="sortNumberColumn('uniformityScore', (faction) => faction.uniformityScore)"
                >
                  <span>Geschlossen&shy;heit</span>
                  <span class="iconify lucide--chevrons-up-down"></span>
                </button>
              </th>
              <th class="hidden @2xl:table-cell text-right">
                <button
                  class="hover:text-primary flex w-full cursor-pointer items-center justify-end gap-1 font-semibold whitespace-normal"
                  @click="sortNumberColumn('participationRate', (faction) => faction.participationRate)"
                >
                  <span>Abstimmungs&shy;teilnahme</span>
                  <span class="iconify lucide--chevrons-up-down"></span>
                </button>
              </th>
              <th class="hidden @4xl:table-cell text-right">
                <button
                  class="hover:text-primary flex w-full cursor-pointer items-center justify-end gap-1 font-semibold whitespace-normal"
                  @click="sortNumberColumn('abstentionRate', faction => faction.abstentionRate)"
                >
                  <span>Stimm&shy;enthaltungen</span>
                  <span class="iconify lucide--chevrons-up-down"></span>
                </button>
              </th>
              <th class="hidden @6xl:table-cell text-right">
                <button
                  class="hover:text-primary flex w-full cursor-pointer items-center justify-end gap-1 font-semibold whitespace-normal"
                  @click="sortNumberColumn('motionsSuccessRate', faction => faction.motionsSuccessRate)"
                >
                  <span>Erfolgreiche Anträge</span>
                  <span class="iconify lucide--chevrons-up-down"></span>
                </button>
              </th>
              <th class="hidden @6xl:table-cell text-right">
                <button
                  class="hover:text-primary flex w-full cursor-pointer items-center justify-end gap-1 font-semibold whitespace-normal"
                  @click="sortNumberColumn('speakingTime', faction => faction.speakingTime)"
                >
                  <span>Redezeit</span>
                  <span class="iconify lucide--chevrons-up-down"></span>
                </button>
              </th>
            </tr>
          </thead>
          <tbody>
            <template x-for="faction in factions">
              <tr>
                <th scope="row" class="bg-base-100 font-normal">
                  <a
                    :href="siteRoutes(parliamentPeriodId).faction(faction.id)"
                    class="link link-hover link-primary"
                    x-text="faction.name"
                  ></a>
                </th>
                <td
                  class="hidden @[22rem]:table-cell text-right whitespace-nowrap tabular-nums"
                  x-text="faction.seats"
                ></td>
                <td
                  class="text-right whitespace-nowrap tabular-nums"
                  x-text="faction.votingSuccessRateDisplay"
                ></td>
                <td
                  class="text-right hidden @2xl:table-cell tabular-nums"
                  x-text="faction.uniformityScoreDisplay"
                ></td>
                <td
                  class="text-right hidden @2xl:table-cell tabular-nums"
                  x-text="faction.participationRateDisplay"
                ></td>
                <td
                  class="text-right hidden @4xl:table-cell tabular-nums"
                  x-text="faction.abstentionRateDisplay"
                ></td>
                <td
                  class="text-right hidden @6xl:table-cell tabular-nums"
                  x-text="faction.motionsSuccessRateDisplay"
                ></td>
                <td
                  class="text-right hidden @6xl:table-cell tabular-nums"
                  x-text="faction.speakingTimeDisplay"
                ></td>
              </tr>
            </template>
          </tbody>
        </table>
        <p class="text-base-content/70 px-4 py-3 text-xs @6xl:hidden">
          Weitere Kennzahlen zeigt die Tabelle auf größeren Bildschirmen.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="card card-border bg-base-100">
        <div class="card-body">
          <h2 class="card-title">Abstimmungserfolg</h2>
          <p class="text-base-content/70 mb-3 text-sm">
            Gibt an, wie häufig das Abstimmungsergebnis mit dem Votum der
            Fraktion übereinstimmte.
          </p>
          <div
            id="voting-success-rate-chart-container"
            class="relative"
            style={{ height: `${barHeight}px` }}
            data-parliament-period-id={parliamentPeriod.id}
            data-chart-data={JSON.stringify(votingSuccessRateChartData)}
          >
            <canvas id="voting-success-rate-chart"></canvas>
          </div>
        </div>
      </div>

      <div class="card card-border bg-base-100">
        <div class="card-body">
          <h2 class="card-title">Geschlossenheit</h2>
          <p class="text-base-content/70 mb-3 text-sm">
            Ein Wert zwischen 0 und 1 gibt an, wie einheitlich die
            Fraktionsmitglieder abgestimmt haben. Je größer der Wert ist, desto
            geschlossener ist das Abstimmungsverhalten der Fraktion.
          </p>
          <div
            id="uniformity-score-chart-container"
            class="relative"
            style={{ height: `${barHeight}px` }}
            data-parliament-period-id={parliamentPeriod.id}
            data-chart-data={JSON.stringify(uniformityScoreChartData)}
          >
            <canvas id="uniformity-score-chart"></canvas>
          </div>
        </div>
      </div>

      <div class="card card-border bg-base-100">
        <div class="card-body">
          <h2 class="card-title">Abstimmungsteilnahme</h2>
          <p class="text-base-content/70 mb-3 text-sm">
            Gibt an, wie häufig die Fraktionsmitglieder an Abstimmungen
            teilgenommen haben.
          </p>
          <div
            id="participation-rate-chart-container"
            class="relative"
            style={{ height: `${barHeight}px` }}
            data-parliament-period-id={parliamentPeriod.id}
            data-chart-data={JSON.stringify(participationRateChartData)}
          >
            <canvas id="participation-rate-chart"></canvas>
          </div>
        </div>
      </div>

      <div class="card card-border bg-base-100">
        <div class="card-body">
          <h2 class="card-title">Stimmenthaltungen</h2>
          <p class="text-base-content/70 mb-3 text-sm">
            Gibt an, wie hoch der Anteil der abgegebenen Stimmen ist, die weder
            dafür noch dagegen waren
          </p>
          <div
            id="abstention-rate-chart-container"
            class="relative"
            style={{ height: `${barHeight}px` }}
            data-parliament-period-id={parliamentPeriod.id}
            data-chart-data={JSON.stringify(abstentionRateChartData)}
          >
            <canvas id="abstention-rate-chart"></canvas>
          </div>
        </div>
      </div>

      <div class="card card-border bg-base-100">
        <div class="card-body">
          <h2 class="card-title">Erfolgreiche Anträge</h2>
          <p class="text-base-content/70 mb-3 text-sm">
            Anteil der Anträge, die durch die Fraktion gestellt wurde und durch
            einen Mehrheitsbeschluss angenommen wurden.
          </p>
          <div
            id="motions-success-rate-chart-container"
            class="relative"
            style={{ height: `${barHeight}px` }}
            data-parliament-period-id={parliamentPeriod.id}
            data-chart-data={JSON.stringify(motionsSuccessRateChartData)}
          >
            <canvas id="motions-success-rate-chart"></canvas>
          </div>
        </div>
      </div>

      <div class="card card-border bg-base-100">
        <div class="card-body">
          <h2 class="card-title">Redezeit</h2>
          <p class="text-base-content/70 mb-3 text-sm">
            Gibt an, wieviel Zeit die Mitglieder der Fraktionen insgesamt in den
            Ratssitzungen gesprochen haben.
          </p>
          <div
            id="speaking-time-chart-container"
            class="relative"
            style={{ height: `${barHeight}px` }}
            data-parliament-period-id={parliamentPeriod.id}
            data-chart-data={JSON.stringify(speakingTimesChartData)}
          >
            <canvas id="speaking-times-chart"></canvas>
          </div>
        </div>
      </div>
    </div>
  </div>
</PageLayout>

<script>
  import { siteRoutes } from '@utils/routes';
  import Alpine from 'alpinejs';
  import { type FactionListItem } from './_models';
  import { rankingBarChart } from '@utils/charts';
  import { type ChartDataPoint } from './_models';

  document.addEventListener('alpine:init', () => {
    const factionsTableElement = document.querySelector(
      '[data-factions]',
    ) as HTMLTableElement;
    const factions = JSON.parse(
      factionsTableElement.dataset.factions || '[]',
    ) as FactionListItem[];
    const parliamentPeriodId = factionsTableElement.dataset.parliamentPeriodId;

    Alpine.data('factions', () => ({
      parliamentPeriodId,
      siteRoutes,
      factions,
      sortTextColumn: function (
        column: string,
        getText: (faction: FactionListItem) => string,
      ) {
        this._updateSortColumn(column);
        this.factions.sort((a, b) =>
          this._sortedDesc
            ? getText(b).localeCompare(getText(a))
            : getText(a).localeCompare(getText(b)),
        );
      },
      sortNumberColumn: function (
        column: string,
        getNumber: (faction: FactionListItem) => number | null,
      ) {
        this._updateSortColumn(column);
        this.factions.sort((a, b) =>
          this._sortedDesc
            ? (getNumber(a) || 0) - (getNumber(b) || 0)
            : (getNumber(b) || 0) - (getNumber(a) || 0),
        );
      },
      _sortedColumn: 'seats',
      _sortedDesc: false,
      _updateSortColumn: function (column: string) {
        if (this._sortedColumn === column) {
          this._sortedDesc = !this._sortedDesc;
        } else {
          this._sortedColumn = column;
          this._sortedDesc = false;
        }
      },
    }));
  });

  createChart(
    'voting-success-rate-chart-container',
    'voting-success-rate-chart',
  );

  createChart('uniformity-score-chart-container', 'uniformity-score-chart');

  createChart('participation-rate-chart-container', 'participation-rate-chart');

  createChart('abstention-rate-chart-container', 'abstention-rate-chart');

  createChart(
    'motions-success-rate-chart-container',
    'motions-success-rate-chart',
  );

  createChart('speaking-time-chart-container', 'speaking-times-chart');

  function createChart(
    chartContainerElementId: string,
    chartElementId: string,
  ) {
    const chartContainerDiv = document.getElementById(
      chartContainerElementId,
    ) as HTMLDivElement;
    const data = JSON.parse(
      chartContainerDiv.dataset.chartData || '[]',
    ) as ChartDataPoint[];
    const parliamentPeriodId = chartContainerDiv.dataset
      .parliamentPeriodId as string;
    rankingBarChart(
      document.getElementById(chartElementId) as HTMLCanvasElement,
      data,
      (point) => {
        window.location.href = siteRoutes(parliamentPeriodId).faction(
          point.factionId,
        );
      },
    );
  }
</script>
