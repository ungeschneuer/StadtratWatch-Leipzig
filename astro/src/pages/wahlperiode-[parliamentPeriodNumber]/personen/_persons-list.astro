---
import { siteRoutes } from '@utils/routes';
import { sortValue } from '@utils/sortable-table';
import { nameForSorting } from '@models/person-name';
import { compareNamesForSorting } from '@models/person-name';
import { personsWithRecordedVotes } from '@data-analysis/RecordedVotes';
import { type PersonListItem } from './_models';
import { type Registry } from '@models/registry';
import { type SessionInput } from '@models/SessionInput';
import { calcParticipationRateOfPerson } from '@data-analysis/ParticipationRate';
import { calcVotingSuccessRateOfPerson } from '@data-analysis/VotingSuccess';
import { calcAbstentionRateOfPerson } from '@data-analysis/AbstentionRate';
import { calcSpeakingTimeOfPerson } from '@data-analysis/SpeakingTime';
import {
  formatAbstentionRate,
  formatParticipationRate,
  formatVotingSuccessRate,
} from '@utils/format-number';
import { formatSpeakingTime } from '@utils/format-time';
import { isPersonInSession } from '@utils/session-utils';

type Props = {
  parliamentPeriod: Registry;
  sessionInputs: SessionInput[];
};

const { parliamentPeriod, sessionInputs } = Astro.props as Props;

const persons = personsWithRecordedVotes(parliamentPeriod, sessionInputs)
  .map((person) => {
    const faction = parliamentPeriod.factions.find(
      (faction) => faction.id === person.factionId,
    )!.name;
    const party =
      parliamentPeriod.parties.find((party) => party.id === person.partyId)
        ?.name || 'parteilos';

    const relevantSessions = sessionInputs.filter((session) =>
      isPersonInSession(person, session.session),
    );

    const participationRate = calcParticipationRateOfPerson(
      person,
      relevantSessions,
    );
    const votingSuccessRate = calcVotingSuccessRateOfPerson(
      parliamentPeriod,
      person,
      relevantSessions,
    );
    const abstentionRate = calcAbstentionRateOfPerson(person, relevantSessions);
    const speakingTime = calcSpeakingTimeOfPerson(person, relevantSessions);

    return {
      id: person.id,
      name: person.name,
      factionId: person.factionId,
      faction,
      partyId: person.partyId,
      party,
      participationRate,
      participationRateDisplay: formatParticipationRate(participationRate),
      votingSuccessRate,
      votingSuccessRateDisplay: formatVotingSuccessRate(votingSuccessRate),
      abstentionRate,
      abstentionRateDisplay: formatAbstentionRate(abstentionRate),
      speakingTime,
      speakingTimeDisplay: formatSpeakingTime(speakingTime),
    } satisfies PersonListItem;
  })
  .toSorted((a, b) => compareNamesForSorting(a.name, b.name));
const parliamentPeriodId = parliamentPeriod.id;
---

<div id="persons-list" class="@container overflow-x-auto">
  <table data-sortable class="table table-sm md:table-md table-pin-cols">
    <thead>
      <tr>
        <th aria-sort="ascending">
          <button
            class="hover:text-primary flex w-full cursor-pointer items-center justify-between gap-1 text-left font-semibold whitespace-normal"
            type="button"
            data-sort-type="text"
          >
            <span>Name</span>
            <span class="iconify lucide--chevrons-up-down"></span>
          </button>
        </th>
        <th>
          <button
            class="hover:text-primary flex w-full cursor-pointer items-center justify-between gap-1 text-left font-semibold whitespace-normal"
            type="button"
            data-sort-type="text"
          >
            <span>Fraktion</span>
            <span class="iconify lucide--chevrons-up-down"></span>
          </button>
        </th>
        <th class="hidden @4xl:table-cell">
          <button
            class="hover:text-primary flex w-full cursor-pointer items-center justify-between gap-1 text-left font-semibold whitespace-normal"
            type="button"
            data-sort-type="text"
          >
            <span>Partei</span>
            <span class="iconify lucide--chevrons-up-down"></span>
          </button>
        </th>
        <th class="hidden @xl:table-cell text-right">
          <button
            class="hover:text-primary flex w-full cursor-pointer items-center justify-end gap-1 font-semibold whitespace-normal"
            type="button"
            data-sort-type="number"
          >
            <span>abgestimmt</span>
            <span class="iconify lucide--chevrons-up-down"></span>
          </button>
        </th>
        <th class="hidden @2xl:table-cell text-right">
          <button
            class="hover:text-primary flex w-full cursor-pointer items-center justify-end gap-1 font-semibold whitespace-normal"
            type="button"
            data-sort-type="number"
          >
            <span>Abstimmungs&shy;erfolg</span>
            <span class="iconify lucide--chevrons-up-down"></span>
          </button>
        </th>
        <th class="hidden @4xl:table-cell text-right">
          <button
            class="hover:text-primary flex w-full cursor-pointer items-center justify-end gap-1 font-semibold whitespace-normal"
            type="button"
            data-sort-type="number"
          >
            <span>Stimm&shy;enthaltungen</span>
            <span class="iconify lucide--chevrons-up-down"></span>
          </button>
        </th>
        <th class="hidden @5xl:table-cell text-right">
          <button
            class="hover:text-primary flex w-full cursor-pointer items-center justify-end gap-1 font-semibold whitespace-normal"
            type="button"
            data-sort-type="number"
          >
            <span>Redezeit</span>
            <span class="iconify lucide--chevrons-up-down"></span>
          </button>
        </th>
      </tr>
    </thead>
    <tbody>
      {persons.map((person) => (
        <tr>
          <th
            scope="row"
            class="bg-base-100 font-normal"
            data-sort-value={nameForSorting(person.name)}
          >
            <a
              href={siteRoutes(parliamentPeriodId).person(person.id)}
              class="link link-hover link-primary"
            >
              {person.name}
            </a>
          </th>
          <td>
            <a
              href={siteRoutes(parliamentPeriodId).faction(person.factionId)}
              class="link link-hover link-primary"
            >
              {person.faction}
            </a>
          </td>
          <td class="hidden @4xl:table-cell">
            <a
              href={siteRoutes(parliamentPeriodId).party(person.partyId)}
              class="link link-hover link-primary"
            >
              {person.party}
            </a>
          </td>
          <td
            class="text-right hidden @xl:table-cell tabular-nums"
            data-sort-value={sortValue(person.participationRate)}
          >
            {person.participationRateDisplay}
          </td>
          <td
            class="text-right hidden @2xl:table-cell tabular-nums"
            data-sort-value={sortValue(person.votingSuccessRate)}
          >
            {person.votingSuccessRateDisplay}
          </td>
          <td
            class="text-right hidden @4xl:table-cell tabular-nums"
            data-sort-value={sortValue(person.abstentionRate)}
          >
            {person.abstentionRateDisplay}
          </td>
          <td
            class="text-right hidden @5xl:table-cell tabular-nums"
            data-sort-value={sortValue(person.speakingTime)}
          >
            {person.speakingTimeDisplay}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="text-base-content/70 px-4 py-3 text-xs @5xl:hidden">
    Weitere Kennzahlen zeigt die Tabelle auf größeren Bildschirmen.
  </p>
</div>

<script>
  import { makeTablesSortable } from '@utils/sortable-table';

  makeTablesSortable();
</script>
