---
import StatisticsTable, {
  type StatisticsMeasure,
} from '@components/StatisticsTable.astro';
import { type RegistryParty } from '@models/registry';
import { type SessionInput } from '@models/SessionInput';
import {
  calcVotingSuccessRateOfParty,
  calcVotingSuccessRateHistoryOfParty,
} from '@data-analysis/VotingSuccess';
import {
  calcUniformityScoreHistoryOfParty,
  calcUniformityScoreOfParty,
} from '@data-analysis/UniformityScore';
import {
  calcParticipationRateHistoryOfParty,
  calcParticipationRateOfParty,
} from '@data-analysis/ParticipationRate';
import {
  calcAbstentionRateHistoryOfParty,
  calcAbstentionRateOfParty,
} from '@data-analysis/AbstentionRate';
import { formatPercentage, formatScore } from '@utils/format-number';
import { calcSeatsHistoryOfParty } from '@data-analysis/Seats';
import { formatDate } from '@utils/format-date';
import { type Registry } from '@models/registry';

type Props = {
  parliamentPeriod: Registry;
  party: RegistryParty;
  sessionInputs: SessionInput[];
};

const { parliamentPeriod, party, sessionInputs } = Astro.props as Props;

const votingsSuccessRate = calcVotingSuccessRateOfParty(
  parliamentPeriod,
  party,
  sessionInputs,
);
const votingsSuccessRateHistory = calcVotingSuccessRateHistoryOfParty(
  parliamentPeriod,
  party,
  sessionInputs,
);
const uniformityScore = calcUniformityScoreOfParty(
  parliamentPeriod,
  party,
  sessionInputs,
);
const uniformityScoreHistory = calcUniformityScoreHistoryOfParty(
  parliamentPeriod,
  party,
  sessionInputs,
);
const participationRate = calcParticipationRateOfParty(
  parliamentPeriod,
  party,
  sessionInputs,
);
const participationRateHistory = calcParticipationRateHistoryOfParty(
  parliamentPeriod,
  party,
  sessionInputs,
);
const abstentionRate = calcAbstentionRateOfParty(
  parliamentPeriod,
  party,
  sessionInputs,
);
const abstentionRateHistory = calcAbstentionRateHistoryOfParty(
  parliamentPeriod,
  party,
  sessionInputs,
);
const seatsHistory = calcSeatsHistoryOfParty(
  parliamentPeriod,
  party,
  sessionInputs,
);

const measures: StatisticsMeasure[] = [
  {
    id: 'seats',
    label: 'Sitze',
    value: String(party.seats),
    explanation:
      'Sitze heute. Ändern sie sich durch Nachrückende, Austritte oder Wechsel, steht darunter der Stand an den Sitzungen mit einer Änderung.',
    detail:
      seatsHistory.length > 1
        ? seatsHistory
            .map((point) => `${formatDate(point.date)}: ${point.value}`)
            .join('; ')
        : undefined,
  },
  {
    id: 'voting-success-rate',
    label: 'Abstimmungserfolg',
    value: formatPercentage(votingsSuccessRate),
    explanation:
      'Wie häufig das Abstimmungsergebnis mit dem Votum der Partei übereinstimmte.',
    history: votingsSuccessRateHistory,
  },
  {
    id: 'uniformity-score',
    label: 'Geschlossenheit',
    value: formatScore(uniformityScore),
    explanation:
      'Ein Wert zwischen 0 und 1: wie einheitlich die Parteimitglieder abgestimmt haben. Je größer, desto geschlossener.',
    history: uniformityScoreHistory,
    format: 'score',
  },
  {
    id: 'participation-rate',
    label: 'Abstimmungsteilnahme',
    value: formatPercentage(participationRate),
    explanation:
      'Wie häufig die Parteimitglieder an Abstimmungen teilgenommen haben.',
    history: participationRateHistory,
  },
  {
    id: 'abstention-rate',
    label: 'Stimmenthaltungen',
    value: formatPercentage(abstentionRate),
    explanation:
      'Anteil der abgegebenen Stimmen, die weder dafür noch dagegen waren.',
    history: abstentionRateHistory,
  },
];
---

<StatisticsTable measures={measures} />
