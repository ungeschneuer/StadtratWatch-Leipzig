---
import { siteRoutes } from '@utils/routes';
import { type SessionInput } from '@models/SessionInput';
import { personsWithRecordedVotes } from '@data-analysis/RecordedVotes';
import { type Registry, type RegistryParty } from '@models/registry';
import { affiliationMembers, partyHistory } from '@models/person-affiliation';
import CouncilorList, { type Councilor } from '@components/CouncilorList.astro';
import { formatPeriod } from '@utils/format-period';

type Props = {
  parliamentPeriod: Registry;
  sessionInputs: SessionInput[];
  party: RegistryParty;
};

const { parliamentPeriod, party, sessionInputs } = Astro.props as Props;

// Everyone who belonged to the party in the period; members who changed show when they belonged to it.
const councilors: Councilor[] = affiliationMembers(
  personsWithRecordedVotes(parliamentPeriod, sessionInputs),
  partyHistory,
  party.id,
).map(({ person, periods, isCurrent, changed }) => ({
  url: siteRoutes(parliamentPeriod.id).person(person.id),
  name: person.name,
  end: person.end,
  otherAffiliation: getFactionName(person.factionId),
  isCurrent,
  membershipPeriods: changed
    ? periods.map((period) => formatPeriod(period.start, period.end)).join(', ')
    : null,
}));

function getFactionName(factionId: string) {
  const faction = parliamentPeriod.factions.find(
    (faction) => faction.id === factionId,
  );
  return faction ? faction.name : '';
}
---

<CouncilorList councilors={councilors} membershipLabel="In der Partei" />
