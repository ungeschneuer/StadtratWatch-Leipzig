---
import { siteRoutes } from '@utils/routes';
import PageLayout from '@layouts/PageLayout.astro';
import { formatDate } from '@utils/format-date';
import {
  type ParliamentPeriodWithSessionAndVotingProps,
  getParliamentPeriodWithSessionAndVotingPaths,
} from '../../../../_helpers';
import MetaTags from '@components/MetaTags.astro';
import VotingReviewNotice from '@components/VotingReviewNotice.astro';
import VoteBadge from '@components/VoteBadge.astro';
import PaperFamilyTree from '@components/PaperFamilyTree.astro';
import {
  familyBranchOf,
  familyVotingCount,
} from '@data-analysis/PaperFamilies';
import { describeUnassignedVotes } from '@utils/unassigned-votes';
import VotingQuotationImage from '@components/VotingQuotationImage.astro';
import { quotationImageUrl } from '@utils/quotation-image';
import { getVideoTimestampAsSeconds } from '@utils/session-utils';
import { sessionVideoLink } from '@models/session-video';
import { factionIdOn } from '@models/person-affiliation';
import {
  decidedByMayor,
  getVoteCounts,
  votingAccepted,
} from '@models/voting-breakdown';
import {
  getMajorityRequirement,
  getQualifiedMajorityRequirementName,
} from '@models/session-scan';

export const getStaticPaths = getParliamentPeriodWithSessionAndVotingPaths;

const { sessionId } = Astro.params;
const { parliamentPeriod, sessionInput, voting, shownPersonIds, paperFamily } =
  Astro.props as ParliamentPeriodWithSessionAndVotingProps;
const parliamentPeriodId = parliamentPeriod.id;
const mayorDecided = decidedByMayor(
  parliamentPeriod,
  voting,
  sessionInput.session.date,
);
const recusedPersons = voting.recusedPersons ?? [];
const boardCounts = getVoteCounts(voting);
const officialCounts = voting.unresolved?.officialCounts;
// The votes per person are the board's with the changes a reviewer could prove, so they are named as assigned votes.
const unresolvedCountsText = officialCounts
  ? `Das amtliche Ergebnis lautet ${officialCounts.J}:${officialCounts.N}:${officialCounts.E}, Personen zugeordnet sind ${boardCounts.J}:${boardCounts.N}:${boardCounts.E}. `
  : 'Diese Abstimmung ließ sich nicht abschließend prüfen. ';
const unassignedVotesText = voting.unresolved?.unassignedCounts
  ? describeUnassignedVotes(voting.unresolved.unassignedCounts)
  : '';
const possibleVoters = voting.unresolved?.possibleVoters ?? [];
const familyBranch =
  paperFamily && voting.votingSubject.oparlPaperId
    ? familyBranchOf(paperFamily, voting.votingSubject.oparlPaperId)
    : null;

const breadcrumbItems = [
  {
    name: parliamentPeriod.name,
    href: siteRoutes(parliamentPeriodId).parliamentPeriod(),
  },
  {
    name: 'Sitzungen',
    href: siteRoutes(parliamentPeriodId).sessions(),
  },
  {
    name: formatDate(sessionInput.session.date),
    href: siteRoutes(parliamentPeriodId).session(sessionId),
  },
  {
    name:
      [voting.votingSubject.type, voting.votingSubject.motionId]
        .filter(Boolean)
        .join(' ') || `TOP ${voting.votingSubject.agendaItem}`,
    href: null,
  },
];

const votesWithFaction = voting.votes.map((vote) => {
  const person = parliamentPeriod.persons.find(
    (person) => person.name === vote.name,
  );
  if (!person) {
    throw new Error(`Person ${vote.name} not found`);
  }

  const factionId = factionIdOn(person, sessionInput.session.date);
  const faction = parliamentPeriod.factions.find(
    (faction) => faction.id === factionId,
  );
  if (!faction) {
    throw new Error(`Person ${person.name} not found`);
  }

  return {
    personId: person.id,
    personName: person.name,
    factionName: faction.name,
    vote: vote.vote,
  };
});
// Members who never cast a vote in the recorded sessions have no page; the board lists them without a vote.
const shownVotes = votesWithFaction.filter((vote) =>
  shownPersonIds.includes(vote.personId),
);
const votesGroupedByFaction = shownVotes.reduce(
  (acc, vote) => {
    if (!acc[vote.factionName]) {
      acc[vote.factionName] = [];
    }
    acc[vote.factionName].push(vote);
    return acc;
  },
  {} as Record<string, typeof votesWithFaction>,
);
const groupsSortedByVotes = Object.entries(votesGroupedByFaction).sort(
  (a, b) => b[1].length - a[1].length,
);

const videoLink = sessionVideoLink(
  sessionInput.session,
  getVideoTimestampAsSeconds(voting),
);

const quotationImage = quotationImageUrl(
  sessionInput.session.id,
  voting.votingFilename,
);

const { J: votedFor, N: votedAgainst, E: abstentions } = getVoteCounts(voting);
const totalVotes = votedFor + votedAgainst + abstentions;
const accepted = votingAccepted(parliamentPeriod, voting);
const qualifiedMajorityRequirementName = getQualifiedMajorityRequirementName(
  getMajorityRequirement(voting),
);
---

<PageLayout
  parliamentPeriod={parliamentPeriod}
  pageTitle="Abstimmung"
  searchTitle={`TOP ${voting.votingSubject.agendaItem}: ${voting.votingSubject.title}`}
  breadcrumbItems={breadcrumbItems}
>
  <MetaTags
    slot="srw-meta-tags"
    sessionDate={sessionInput.session.date}
    voting={voting}
  />

  {videoLink && (
    <div slot="sub-page-header">
      <a
        href={videoLink.url}
        target="_blank"
        class="link link-primary inline-flex items-center gap-1 text-xs"
      >
        <span class:list={['iconify', videoLink.icon]} />
        {videoLink.text}
      </a>
    </div>
  )}

  <div class="space-y-4">
    {voting.reviewStatus && (
      <VotingReviewNotice
        reviewStatus={voting.reviewStatus}
        sessionId={sessionId}
      />
    )}
    {voting.unresolved && (
      <div role="note" class="alert alert-soft text-sm">
        <div>
          <p>
            {unresolvedCountsText}
            {unassignedVotesText ||
              `Die Prüfung konnte das nicht klären (${voting.unresolved.reason}).`}{' '}
            Ob angenommen oder abgelehnt, richtet sich nach dem amtlichen
            Ergebnis.
          </p>
          {possibleVoters.length > 0 && (
            <p class="mt-2">
              Infrage kommen nur Mitglieder, die anwesend waren, aber auf der
              Tafel keine Stimme haben: {possibleVoters.join(', ')}. Bei ihnen
              steht „unklar“; die Abstimmung zählt nicht in ihre Teilnahmequote.
            </p>
          )}
          {unassignedVotesText && (
            <p class="mt-2 text-base-content/70">
              Begründung der Prüfung: {voting.unresolved.reason}
            </p>
          )}
        </div>
      </div>
    )}
    {/* Column counts follow the space next to the sidebar, not the window, so names and the result never get squeezed. */}
    <div class="@container">
      <div class="grid grid-cols-1 gap-4 @2xl:grid-cols-3 @6xl:grid-cols-4">
        <div class="card bg-base-100 border border-base-300 @2xl:col-span-2 @6xl:col-span-3">
          <div class="card-body">
            <div class="text-base-content/70 text-sm">
              {`TOP ${voting.votingSubject.agendaItem}`}
              {voting.votingSubject.itemNumber &&
                `, Punkt ${voting.votingSubject.itemNumber}`}
              {(voting.votingSubject.type || voting.votingSubject.motionId) &&
                ' · '}
              {voting.votingSubject.type &&
                `${voting.votingSubject.type}${voting.votingSubject.motionId ? ' ' : ''}`}
              {voting.votingSubject.paperUrl ? (
                <a
                  href={voting.votingSubject.paperUrl}
                  target="_blank"
                  class="link link-primary"
                  title="Drucksache im Ratsinformationssystem der Stadt Leipzig"
                >
                  {`Drucksache ${voting.votingSubject.motionId}`}
                </a>
              ) : (
                voting.votingSubject.motionId
              )}
            </div>
            <p class="mt-1 mb-3">{voting.votingSubject.title}</p>
            <div class="flex flex-wrap gap-1">
              {voting.votingSubject.authors.map((author) => (
                <span class="badge badge-neutral badge-sm">{author}</span>
              ))}
            </div>
            {voting.votingSubject.itemNumber && (
              <p class="text-sm text-base-content/70 mt-2">
                Über die Punkte der Vorlage wurde einzeln abgestimmt; diese
                Abstimmung betrifft Punkt {voting.votingSubject.itemNumber}.
              </p>
            )}
            {mayorDecided && (
              <p class="text-sm text-base-content/70 mt-2">
                Die Stimme des Oberbürgermeisters hat entschieden: Ohne sie wäre
                das Ergebnis umgekehrt.
              </p>
            )}
            {recusedPersons.length > 0 && (
              <p class="text-sm text-base-content/70 mt-2">
                Wegen Befangenheit (§ 20 SächsGemO) nicht beteiligt:{' '}
                {recusedPersons.join(', ')}.
              </p>
            )}
          </div>
        </div>

        <div class="card bg-base-100 border border-base-300">
          <div class="card-body">
            <div class="flex flex-col">
              <div class="flex flex-row items-center gap-x-2">
                <progress
                  class="progress progress-success"
                  value={votedFor}
                  max={totalVotes}
                ></progress>
                <span class="w-8 text-right text-sm">{votedFor}</span>
              </div>
              <div class="flex flex-row items-center gap-x-2">
                <progress
                  class="progress progress-error"
                  value={votedAgainst}
                  max={totalVotes}
                ></progress>
                <span class="w-8 text-right text-sm">{votedAgainst}</span>
              </div>
              <div class="flex flex-row items-center gap-x-2">
                <progress
                  class="progress progress-warning"
                  value={abstentions}
                  max={totalVotes}
                ></progress>
                <span class="w-8 text-right text-sm">{abstentions}</span>
              </div>
              {accepted && (
                <div class="badge badge-success badge-lg w-full mt-3">
                  <span class="iconify lucide--check" />
                  Angenommen
                </div>
              )}
              {!accepted && (
                <div class="badge badge-error badge-lg w-full mt-3">
                  <span class="iconify lucide--x" />
                  Abgelehnt
                </div>
              )}
              {qualifiedMajorityRequirementName && (
                <p class="text-xs text-base-content/70 text-center mt-2">
                  {qualifiedMajorityRequirementName}
                </p>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>

    {familyBranch && familyVotingCount(familyBranch.branch) > 1 && (
      <section
        class="card bg-base-100 border-base-300 border"
        aria-labelledby="paper-family-heading"
      >
        <div class="card-body">
          <h2 id="paper-family-heading" class="card-title">
            Vorlage und Änderungen
          </h2>
          <p class="text-base-content/70 text-sm">
            Die Hauptvorlage mit Neufassungen, Änderungsanträgen und
            Verwaltungsstandpunkt, wie das Ratsinformationssystem sie verknüpft,
            und das Ergebnis jeder Abstimmung darüber.
          </p>
          {familyBranch.path.length > 0 && (
            <p class="text-sm">
              Gehört zu{' '}
              {familyBranch.path.map((paper, index) => (
                <>
                  {index > 0 && ' › '}
                  {paper.paperUrl ? (
                    <a href={paper.paperUrl} target="_blank" class="link">
                      {paper.reference}
                    </a>
                  ) : (
                    paper.reference
                  )}{' '}
                  ({paper.name})
                </>
              ))}
            </p>
          )}
          <ul class="mt-2">
            <PaperFamilyTree
              paper={familyBranch.branch}
              currentVotingFilename={voting.votingFilename}
            />
          </ul>
        </div>
      </section>
    )}

    {/* Every vote names all 71 members; in the search index they would bury the person pages under 500 votes. */}
    <div class="@container" data-pagefind-ignore>
      <div class="grid grid-cols-1 gap-4 @lg:grid-cols-2 @3xl:grid-cols-3 @6xl:grid-cols-4">
        {groupsSortedByVotes.map(([faction, votes]) => (
          <div class="card bg-base-100 border border-base-300 self-start">
            <div class="card-body">
              <h2 class="card-title mb-3">{faction}</h2>

              <div role="list" class="border-base-300">
                {votes.map((vote) => (
                  <a
                    role="listitem"
                    href={siteRoutes(parliamentPeriod.id).person(vote.personId)}
                    class="hover:bg-base-200 -mx-2 flex flex-row items-center justify-between gap-2 rounded-field px-2 py-1.5"
                  >
                    <span class="min-w-0 text-sm">{vote.personName}</span>
                    <VoteBadge
                      vote={vote.vote}
                      uncertain={
                        vote.vote === 'O' &&
                        possibleVoters.includes(vote.personName)
                      }
                    />
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    {quotationImage && (
      <VotingQuotationImage
        imageUrl={quotationImage}
        sessionDate={sessionInput.session.date}
        videoTimestamp={voting.videoTimestamp}
      />
    )}
  </div>
</PageLayout>
