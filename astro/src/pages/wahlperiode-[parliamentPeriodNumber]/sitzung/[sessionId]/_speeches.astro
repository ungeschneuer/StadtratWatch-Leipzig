---
import { siteRoutes } from '@utils/routes';
import Speech from '@components/Speech.astro';
import SpeechesSourceNotice from '@components/SpeechesSourceNotice.astro';
import { type SessionInput } from '@models/SessionInput';
import { type Registry } from '@models/registry';

type Props = {
  parliamentPeriod: Registry;
  sessionInput: SessionInput;
};

const { parliamentPeriod, sessionInput } = Astro.props as Props;

const { speechesSource } = sessionInput.session;
const speeches = sessionInput.speeches.filter(
  (speech) => !speech.isChairPerson && !!speech.transcription,
);
---

{speeches.length === 0 ? (
  <p class="text-base-content/70">Es liegen noch keine Redebeiträge vor.</p>
) : (
  <>
    <div class="text-base-content/70 max-w-prose space-y-2 text-sm">
      {speechesSource ? (
        <SpeechesSourceNotice source={speechesSource} />
      ) : (
        <p>
          Die folgenden Redebeiträge wurden automatisiert erstellt und können
          Fehler enthalten. Die Texte dienen nur zur Orientierung und sind nicht
          als offizielle Protokolle zu verstehen. Um Aufzeichnungen der
          Redebeiträge anzuhören, nutzen Sie bitte die Links zur jeweiligen
          Aufzeichnung.
        </p>
      )}
      <p>
        Sollten Sie einen Fehler entdecken, können Sie uns diesen gern melden.
        Wählen Sie dazu im Menü „…“ neben dem jeweiligen Redebeitrag „Beitrag
        melden“ und senden Sie uns eine Nachricht. Wir werden den Fehler
        umgehend prüfen und korrigieren.
      </p>
    </div>

    <ol class="divide-base-300 border-base-300 mt-6 max-w-4xl divide-y border-y">
      {speeches.map((speech) => (
        <li class="py-5">
          <Speech
            parliamentPeriod={parliamentPeriod}
            session={sessionInput.session}
            speech={speech}
            speechElementId={`speech-${speech.start}`}
            link={`${siteRoutes(parliamentPeriod.id).session(sessionInput.session.id)}?tab=speeches`}
          />
        </li>
      ))}
    </ol>

    <p
      id="speech-link-copied"
      role="status"
      class="alert alert-success fixed right-5 bottom-5 hidden"
    >
      Link zum Redebeitrag kopiert
    </p>
  </>
)}

<script>
  document.querySelectorAll('.copy-speech-link-btn').forEach((button) => {
    button.addEventListener('click', async (event) => {
      event.preventDefault();
      if (document.activeElement) {
        (document.activeElement as HTMLElement).blur();
      }
      const href = button.getAttribute('href');
      if (!href) {
        return;
      }
      await navigator.clipboard.writeText(
        new URL(href, window.location.origin).toString(),
      );

      const alert = document.getElementById('speech-link-copied');
      if (alert) {
        alert.classList.remove('hidden');
        setTimeout(() => alert.classList.add('hidden'), 3000);
      }
    });
  });
</script>
