---
import { sitePath } from '@utils/site-path';
import { type Registry, type RegistryParty } from '@models/registry';
import { affiliationMembers, partyHistory } from '@models/person-affiliation';
import { formatDate } from '@utils/format-date';
import { formatPeriod } from '@utils/format-period';

type Props = {
  parliamentPeriod: Registry;
  party: RegistryParty;
};

const { parliamentPeriod, party } = Astro.props as Props;

// Everyone who belonged to the party in the period; members who changed show when they belonged to it.
const persons = affiliationMembers(
  parliamentPeriod.persons,
  partyHistory,
  party.id,
).map(({ person, periods, isCurrent, changed }) => ({
  ...person,
  faction: getFactionName(person.factionId),
  isCurrent,
  membershipPeriods: changed
    ? periods.map((period) => formatPeriod(period.start, period.end)).join(', ')
    : null,
}));

function getFactionName(factionId: string) {
  const faction = parliamentPeriod.factions.find(
    (faction) => faction.id === factionId,
  );
  return faction ? faction.name : '';
}
---

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
  {persons.map((person) => (
    <a
      href={sitePath(`/pp/${parliamentPeriod.id}/person/${person.id}`)}
      class="card card-border border-base-300 bg-base-200 hover:bg-base-300"
      class:list={[{ 'opacity-50': !person.isCurrent }]}
    >
      <div class="card-body p-3">
        <div class="text-sm font-medium">{person.name}</div>
        <div class="text-base-content/70 mt-2 flex items-center text-xs">
          {person.faction}
        </div>
        {person.membershipPeriods && (
          <div class="text-base-content/70 mt-2 flex items-center text-xs">
            In der Partei {person.membershipPeriods}
          </div>
        )}
        {person.end && (
          <div class="text-base-content/70 mt-2 flex items-center text-xs">
            Ratsmitglied bis {formatDate(person.end)}
          </div>
        )}
      </div>
    </a>
  ))}
</div>
