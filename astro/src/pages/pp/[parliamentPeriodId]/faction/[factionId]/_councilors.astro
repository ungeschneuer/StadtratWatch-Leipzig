---
import { type Registry, type RegistryFaction } from '@models/registry';
import { affiliationMembers, factionHistory } from '@models/person-affiliation';
import { formatDate } from '@utils/format-date';
import { formatPeriod } from '@utils/format-period';

type Props = {
  parliamentPeriod: Registry;
  faction: RegistryFaction;
};

const { parliamentPeriod, faction } = Astro.props as Props;

// Everyone who belonged to the faction in the period; members who changed show when they belonged to it.
const persons = affiliationMembers(
  parliamentPeriod.persons,
  factionHistory,
  faction.id,
).map(({ person, periods, isCurrent, changed }) => ({
  ...person,
  party: getPartyName(person.partyId),
  isCurrent,
  membershipPeriods: changed
    ? periods.map((period) => formatPeriod(period.start, period.end)).join(', ')
    : null,
}));

function getPartyName(partyId: string) {
  const party = parliamentPeriod.parties.find((party) => party.id === partyId);
  return party ? party.name : '';
}
---

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
  {persons.map((person) => (
    <a
      href={`/pp/${parliamentPeriod.id}/person/${person.id}`}
      class="card card-border border-base-300 bg-base-200 hover:bg-base-300"
      class:list={[{ 'opacity-50': !person.isCurrent }]}
    >
      <div class="card-body p-3">
        <div class="text-sm font-medium">{person.name}</div>
        <div class="text-base-content/70 mt-2 flex items-center text-xs">
          {person.party}
        </div>
        {person.membershipPeriods && (
          <div class="text-base-content/70 mt-2 flex items-center text-xs">
            In der Fraktion {person.membershipPeriods}
          </div>
        )}
        {person.end && (
          <div class="text-base-content/70 mt-2 flex items-center text-xs">
            Ratsmitglied bis {formatDate(person.end)}
          </div>
        )}
      </div>
    </a>
  ))}
</div>
