---
import { getParliamentPeriodWithSessionsPaths } from '../wahlperiode-[parliamentPeriodNumber]/_helpers';
import Forwarding from '@components/Forwarding.astro';
import { siteRoutes, votingSlugs } from '@utils/routes';
import { getVotingId } from '@models/voting-breakdown';

// Until 13.11.2026 the site's addresses were English and named votes by their number („/pp/leipzig-8/session/
// 2026-03-25/voting/29“). Links to them stay valid: GitHub Pages cannot redirect, so every old address gets a page
// that forwards to the new one and names it as canonical.
export async function getStaticPaths() {
  const periods = await getParliamentPeriodWithSessionsPaths();
  return periods.flatMap(({ props: { parliamentPeriod, sessionInputs } }) => {
    const id = parliamentPeriod.id;
    const routes = siteRoutes(id);
    const forward = (oldPath: string, target: string) => ({
      params: { oldPath: `${id}${oldPath}` },
      props: { target },
    });
    return [
      forward('', routes.parliamentPeriod()),
      forward('/sessions', routes.sessions()),
      forward('/persons', routes.persons()),
      forward('/factions', routes.factions()),
      forward('/parties', routes.parties()),
      ...parliamentPeriod.persons.map((person) =>
        forward(`/person/${person.id}`, routes.person(person.id)),
      ),
      ...parliamentPeriod.factions.map((faction) =>
        forward(`/faction/${faction.id}`, routes.faction(faction.id)),
      ),
      ...parliamentPeriod.parties.map((party) =>
        forward(`/party/${party.id}`, routes.party(party.id)),
      ),
      ...sessionInputs.flatMap(({ session, votings }) => {
        const slugs = votingSlugs(votings);
        return [
          forward(`/session/${session.id}`, routes.session(session.id)),
          ...votings.map((voting) =>
            forward(
              `/session/${session.id}/voting/${getVotingId(voting)}`,
              routes.voting(
                session.id,
                slugs.get(voting.votingFilename) as string,
              ),
            ),
          ),
        ];
      }),
    ];
  });
}

const { target } = Astro.props as { target: string };
---

<Forwarding target={target} />
