---
import ContactEmailLink from '@components/ContactEmailLink.astro';
import Layout from '@layouts/Layout.astro';
import { sitePath } from '@utils/site-path';
import {
  OPERATOR_NAME,
  OPERATOR_PROFILES,
  OPERATOR_WEBSITE,
  SITE_NAME,
  DATA_PULL_REQUEST_URL,
  SOURCE_REPOSITORY_URL,
  UPSTREAM_PROJECT,
} from '@utils/site-config';
---

<Layout>
  {/* Running text reads best at about 65 characters per line, even on wide screens. */}
  <div class="max-w-prose">
    <h1 class="mb-4 text-2xl font-semibold">Kontakt</h1>

    <p class="mb-4">
      {SITE_NAME} wird von {OPERATOR_NAME} betrieben. Erreichbar per E-Mail an{' '}
      <ContactEmailLink class="link link-primary" />; die Anschrift steht im{' '}
      <a href={sitePath('/impressum')} class="link link-primary">
        Impressum
      </a>
      .
    </p>

    <div class="alert alert-soft alert-info">
      <span class="iconify lucide--info size-5"></span>
      <p>
        Diese Seite ist <em>keine</em> offizielle Seite der Stadt Leipzig. Sie
        ist ein unabhängiges Privatprojekt.
      </p>
    </div>

    <h2 class="mt-8 mb-2 text-lg font-semibold">{OPERATOR_NAME} im Netz</h2>

    <ul class="flex flex-wrap gap-x-4 gap-y-1">
      <li>
        <a href={OPERATOR_WEBSITE} class="link link-primary" target="_blank">
          Webseite
        </a>
      </li>
      {OPERATOR_PROFILES.map((profile) => (
        <li>
          <a
            href={profile.url}
            class="link link-primary"
            target="_blank"
            rel={'rel' in profile ? `${profile.rel} noopener` : 'noopener'}
          >
            {profile.label}
          </a>
        </li>
      ))}
    </ul>

    <h2 class="mt-8 mb-2 text-lg font-semibold">Lob, Kritik oder Ideen?</h2>

    <p>
      Schreiben Sie eine E-Mail an{' '}
      <ContactEmailLink class="link link-primary" />.
    </p>

    <h2 class="mt-8 mb-2 text-lg font-semibold">Fehler in den Daten</h2>

    <p>
      Die Stimmen werden automatisch von der Abstimmungstafel im Video gelesen.
      Korrekturen sammeln wir im{' '}
      <a href={DATA_PULL_REQUEST_URL} class="link link-primary" target="_blank">
        offenen Pull Request mit den Leipziger Daten
      </a>
      . Kommentieren Sie dort oder schreiben Sie uns eine E-Mail mit Datum,
      Tagesordnungspunkt und der Stimme, die nicht stimmt.
    </p>

    <h2 class="mt-8 mb-2 text-lg font-semibold">Software</h2>

    <p>
      Die Software ist frei und quelloffen unter der MIT-Lizenz auf{' '}
      <a href={SOURCE_REPOSITORY_URL} target="_blank" class="link link-primary">
        GitHub
      </a>{' '}
      verfügbar. Sie baut auf{' '}
      <a
        href={UPSTREAM_PROJECT.sourceRepositoryUrl}
        target="_blank"
        class="link link-primary"
      >
        {UPSTREAM_PROJECT.name}
      </a>{' '}
      von {UPSTREAM_PROJECT.maintainers} auf.
    </p>

    <p class="mt-3">
      Sicherheitsprobleme melden Sie bitte per E-Mail an{' '}
      <ContactEmailLink class="link link-primary" />.
    </p>
  </div>
</Layout>
