---
import Layout from './Layout.astro';

// Markdown pages name themselves by their first heading, which the frontmatter repeats as title.
const { frontmatter } = Astro.props as { frontmatter?: { title?: string } };
---

<Layout pageTitle={frontmatter?.title}>
  <div
    class="prose
      dark:prose-invert
      prose-headings:font-semibold
      prose-h1:text-xl
      sm:prose-h1:text-2xl
      prose-h2:text-lg
      prose-a:text-primary
      prose-img:rounded-xl"
  >
    <slot />
  </div>
</Layout>
