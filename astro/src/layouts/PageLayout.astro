---
import Layout from '@layouts/Layout.astro';
import MetaTags from '@components/MetaTags.astro';
import PageHeader from '@components/PageHeader.astro';
import { type Registry } from '@models/registry';
import { type BreadcrumbItem } from '@components/BreadcrumbMenu.astro';

type Props = {
  pageTitle: string;
  parliamentPeriod?: Registry;
  breadcrumbItems?: BreadcrumbItem[];
  // The search page itself has nothing to find.
  searchable?: boolean;
  // How search results name the page where pageTitle alone says too little („Abstimmung“).
  searchTitle?: string;
};

const {
  pageTitle,
  parliamentPeriod,
  breadcrumbItems,
  searchable = true,
  searchTitle,
} = Astro.props as Props;
---

<Layout parliamentPeriod={parliamentPeriod} pageTitle={pageTitle}>
  {/* Layout takes this slot as given, so a page without meta tags of its own gets the defaults here. */}
  <Fragment slot="srw-meta-tags">
    {Astro.slots.has('srw-meta-tags') ? (
      <slot name="srw-meta-tags" />
    ) : (
      <MetaTags pageTitle={pageTitle} />
    )}
  </Fragment>

  <div data-pagefind-body={searchable ? '' : undefined}>
    <PageHeader
      pageTitle={pageTitle}
      searchTitle={searchTitle}
      breadcrumbItems={breadcrumbItems}
    />

    <slot name="sub-page-header" />

    <div class="pt-4">
      <slot />
    </div>
  </div>
</Layout>
