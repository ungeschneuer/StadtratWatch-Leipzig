---
import { sitePath } from '@utils/site-path';
import '@styles/global.css';
import Sidebar from '@components/Sidebar.astro';
import Topbar from '@components/Topbar.astro';
import { getEntry } from 'astro:content';
import { type Registry } from '@models/registry';
import MetaTags from '@components/MetaTags.astro';
import { OPERATOR_NAME } from '@utils/site-config';
import { DATA_DISCLAIMER } from '@models/data-disclaimer';
import { DEFAULT_PARLIAMENT_PERIOD } from 'astro:env/server';

type Props = {
  parliamentPeriod?: Registry;
};

let { parliamentPeriod } = Astro.props as Props;
if (!parliamentPeriod) {
  const parliamentPeriodEntry = await getEntry(
    'parliamentPeriods',
    DEFAULT_PARLIAMENT_PERIOD,
  );
  parliamentPeriod = parliamentPeriodEntry?.data!;
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />

    <slot name="srw-meta-tags" />
    <MetaTags />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content={OPERATOR_NAME} />
    <link rel="sitemap" href={sitePath('/sitemap-index.xml')} />
    <link rel="icon" type="image/x-icon" href={sitePath('/favicon.ico')} />
    <link rel="apple-touch-icon" href={sitePath('/apple-touch-icon.png')} />

    <script is:inline define:vars={{ basePath: sitePath('/') }}>
      // Alpine expressions build links in the browser; they reach the base path through this global.
      window.sitePath = (path) => basePath + path.replace(/^\//, '');
    </script>
  </head>

  <body>
    {parliamentPeriod && (
      <div class="drawer lg:drawer-open">
        <input
          id="site-navigation"
          type="checkbox"
          class="drawer-toggle"
          aria-label="Navigation ein- und ausblenden"
        />
        <div class="drawer-content flex min-h-screen min-w-0 flex-col">
          <a
            href="#main"
            class="btn btn-sm btn-primary sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50"
          >
            Zum Inhalt springen
          </a>
          <Topbar />
          <main
            id="main"
            class="mx-auto w-full max-w-screen-2xl grow px-4 py-6 sm:px-6 lg:px-10 lg:py-8"
          >
            <slot />
          </main>
          <footer class="border-base-300 mx-auto w-full max-w-screen-2xl border-t px-4 py-5 sm:px-6 lg:px-10">
            <p class="text-base-content/70 max-w-prose text-sm">
              {DATA_DISCLAIMER} Fehler melden Sie bitte über die{' '}
              <a href={sitePath('/kontakt')} class="link">
                Kontaktseite
              </a>
              .
            </p>
          </footer>
        </div>
        <div class="drawer-side z-40">
          <label
            for="site-navigation"
            aria-label="Navigation schließen"
            class="drawer-overlay"
          />
          <Sidebar parliamentPeriod={parliamentPeriod} />
        </div>
      </div>
    )}
  </body>
</html>
