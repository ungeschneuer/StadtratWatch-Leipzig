{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "src/deps/astro",
    "src/scripts/leipzig-members",
    "src/scripts/leipzig-papers",
    "src/scripts/leipzig-recordings",
    "src/scripts/leipzig-site-data",
    "src/scripts/leipzig-votings"
  ]
}
